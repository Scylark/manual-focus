  /* ============================
     MANIFESTO — single sticky stage with cross-fading lines
     Four full-height spacers create the scroll distance. The stage stays
     sticky at the top of the viewport while you scroll, and the JS picks
     which line is active based on scroll progress through the section.
     Each line slides + blurs in from the right, settles, then slides out
     left as the next one takes over.
     ============================ */
  .manifesto-section {
    position: relative;
    border-top: 1px solid var(--color-line);
    background: var(--color-bg);
  }
  .manifesto-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: var(--space-md);
    overflow: hidden;
    /* Perspective on the stage gives each line real depth — they
       fly through space, not slide across a flat plane. */
    perspective: 1200px;
    perspective-origin: 50% 50%;
  }
  /* The spacers set the scroll distance the four pledges share. 55vh
     each plus a longer final spacer gives every pledge ~60vh of slot,
     ~40vh of it a static hold, so the whole manifesto takes about 3.4
     screens. It was 220vh/260vh (10 screens, 28% of the page), which
     the October 2026 audit flagged as the page's biggest dead stretch. */
  .manifesto-spacer { height: 55vh; }
  /* Trailing extra spacer that gives the senior operators line
     more time on screen — it's the final read of the manifesto,
     deserves the longest hold. */
  .manifesto-spacer.manifesto-spacer-final { height: 75vh; }
  /* The outer .manifesto-line is just a centering container for the
     absolutely-positioned slot in the sticky stage. The opacity, transform
     and blur are driven directly from scroll position by JS per frame, so
     the line glides smoothly with the scroll rather than transitioning at
     thresholds. No CSS transitions on those properties for that reason. */
  .manifesto-line {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding-inline: var(--space-md);
    pointer-events: none;
    opacity: 0;
    will-change: opacity, transform, filter;
  }
  .manifesto-text {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 9vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-transform: uppercase;
    text-align: center;
    max-width: 18ch;
  }
  .manifesto-line-final .manifesto-text {
    font-family: var(--font-family);
    font-weight: 600;
    font-size: clamp(1.5rem, 4.5vw, 3.5rem);
    letter-spacing: -0.01em;
    line-height: 1.2;
    max-width: 24ch;
    text-transform: none;
  }
  .manifesto-line-final .gradient-text {
    background: var(--color-cta-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  @media (max-width: 768px) {
    .manifesto-stage { height: 70vh; }
    /* Mobile: 50vh per pledge, 65vh for the final one. The 70vh stage
       eats into the scroll range, so this still gives each pledge a
       full thumb-swipe of hold. */
    .manifesto-spacer { height: 50vh; }
    .manifesto-spacer.manifesto-spacer-final { height: 65vh; }
    /* Smaller type on mobile so the longer pledges wrap inside the
       viewport instead of running off the edges. Cap with a max-width
       in ch units so the eye doesn't have to track too far. */
    .manifesto-text {
      font-size: clamp(1.75rem, 9vw, 3rem);
      max-width: 14ch;
    }
    .manifesto-line-final .manifesto-text {
      font-size: clamp(1.1rem, 4.5vw, 1.75rem);
      max-width: 22ch;
    }
  }

