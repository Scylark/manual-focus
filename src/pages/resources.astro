---
import Base from '../layouts/Base.astro';
import SEOHead from '../components/SEOHead.astro';
import { url } from '../utils/paths';

const resources = [
  {
    title: 'What is marketing? A Basics minibook',
    file: '/downloads/what-is-marketing-minibook.pdf',
    bytes: 755455,
    format: 'PDF · 53 pages',
    description:
      'The whole job of marketing in one place, from product-market fit, research and product requirements, through the communication hierarchy and the benefits ladder, to channels, the launch campaign, PR and a SOSTAC plan. It follows one hypothetical product launch from start to finish, with eight diagrams, a worksheet for each step, three AI prompts and a one-page plan to fill in.',
    article: '/blog/what-is-marketing-basics',
    articleLabel: 'Read the web version and listen to the episode',
  },
  {
    title: 'SEO audit skill',
    file: '/downloads/seo-audit-skill.md',
    bytes: 9526,
    format: 'SKILL.md',
    description:
      'The skill we use to run end-to-end SEO audits. It covers keyword research and on-page issues. It finds content gaps against your competitors. You finish with a prioritised action plan of quick wins and bigger bets. Drop it into Claude Code as a slash command, or paste it into any LLM as a prompt.',
    article: '/blog/seo-playbook-premium-endurance-brands',
    articleLabel: 'Read the SEO playbook for premium endurance brands',
  },
];
---
<Base title="Free marketing downloads and skills" description="Free downloads from Manual Focus, with no email required. These are the skills and playbooks our team uses with clients.">
  <SEOHead slot="seo" type="website" title="Free marketing downloads and skills" description="Free downloads from Manual Focus, with no email required. These are the skills and playbooks our team uses with clients." breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Resources', url: '/resources' }]} />

  <section class="section">
    <div class="container reveal">
      <div class="eyebrow">RESOURCES</div>
      <h1>Take the playbook.</h1>
      <p class="lead">These downloads are free, with no email gate. They're the skills and playbooks we use with clients. If running them yourself works, great. If you want a hand, <a href={url('/contact/')}>book a free working session</a>.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="resource-grid">
        {resources.map(r => (
          <article class="resource-card">
            <div class="resource-meta mono">{r.format} · {(r.bytes / 1024).toFixed(1)} KB</div>
            <h2 class="resource-title">{r.title}</h2>
            <p class="resource-desc">{r.description}</p>
            <div class="resource-actions">
              <a href={url(r.file)} class="btn-cta" download>Download</a>
              {r.article && (
                <a href={url(r.article)} class="btn-ghost">{r.articleLabel}</a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>The rest lives in The Lens</h2>
      <p class="lead">The brand-voice and message-house work that used to be on this list now ships free in <a href={url('/lens')}>The Lens</a>. It has 47 playbooks with 28 installable skills. The templates are there to download too. Start with <a href={url('/lens/start-here')}>the guide</a> or browse <a href={url('/lens/library')}>the library</a>. Want a specific playbook first? Drop us a note via <a href={url('/contact')}>the enquiry form</a>.</p>
    </div>
  </section>
</Base>

<style>
  .lead {
    color: var(--color-text-secondary);
    font-size: var(--font-size-lg);
    max-width: var(--max-width-prose);
    margin-top: var(--space-md);
  }
  .lead a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .resource-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }
  .resource-card {
    padding: var(--space-md);
    border: 1px solid var(--color-line);
    border-radius: 4px;
    background: var(--color-bg);
    position: relative;
    overflow: hidden;
  }
  .resource-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--color-cta-gradient);
  }
  .resource-meta {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    text-transform: uppercase;
    margin-bottom: var(--space-sm);
  }
  .resource-title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.05;
    margin-bottom: var(--space-sm);
  }
  .resource-desc {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body);
    line-height: 1.55;
    max-width: 60ch;
    margin-bottom: var(--space-md);
  }
  .resource-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
  }
</style>
