<script>
  // The focus scene. One canvas of dots, driven by scroll position.
  //   Beat 0  noise      every dot out of focus, drifting
  //   Beat 1  shortlist  the dots that fit sharpen and gather, the rest fade
  //   Beat 2  pipeline   the shortlist stacks into five stages
  //   Beat 3  loop       the pipeline runs as two rings, the Manual Focus mark
  // Colours come from the theme tokens and follow the light and dark toggle.
  // With reduced motion the script never starts and the panels stay stacked.
  const scene = document.querySelector<HTMLElement>('[data-scene]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (scene && !reduceMotion) {
    const stage = scene.querySelector<HTMLElement>('.scene-stage')!;
    const canvas = scene.querySelector<HTMLCanvasElement>('.scene-canvas')!;
    const ctx = canvas.getContext('2d');
    const panels = Array.from(scene.querySelectorAll<HTMLElement>('.scene-panel'));
    const ticks = Array.from(scene.querySelectorAll<HTMLElement>('.scene-scale li'));
    const fill = scene.querySelector<HTMLElement>('.scene-scale-fill');
    const hint = scene.querySelector<HTMLElement>('.scene-hint');

    if (ctx) {
      scene.classList.add('is-live');

      type RGB = [number, number, number];
      type Dot = {
        nx: number; ny: number; ax: number; ay: number;
        depth: number; phase: number; delay: number; u: number; jitter: number;
        col: number; slot: number; ring: number; ringPos: number;
        noise: RGB; rgb: RGB;
      };

      // Seeded, so the field looks the same on every visit.
      let seed = 20261110;
      const rnd = () => {
        seed = (seed + 0x6d2b79f5) | 0;
        let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };

      const STAGES = ['Research', 'Contact', 'Meeting', 'Proposal', 'Signed'];
      const CAPTIONS = ['Every company that could buy', 'The accounts that fit', 'The pipeline', 'The weekly loop'];
      const SHARE = [0.4, 0.26, 0.17, 0.11, 0.06];
      const COUNT = window.innerWidth < 768 ? 340 : 900;
      const colCounts = [0, 0, 0, 0, 0];
      const dots: Dot[] = [];
      for (let i = 0; i < COUNT; i++) {
        let col = -1;
        let slot = 0;
        if (rnd() < 0.34) {
          const r = rnd();
          let acc = 0;
          col = 4;
          for (let c = 0; c < SHARE.length; c++) {
            acc += SHARE[c];
            if (r < acc) { col = c; break; }
          }
          slot = colCounts[col]++;
        }
        dots.push({
          nx: rnd(), ny: rnd(), ax: (rnd() + rnd()) / 2, ay: (rnd() + rnd()) / 2,
          depth: 0.25 + rnd() * 0.75, phase: rnd() * Math.PI * 2, delay: rnd() * 0.35,
          u: rnd(), jitter: rnd() - 0.5, col, slot, ring: 0, ringPos: 0,
          noise: [0, 0, 0], rgb: [0, 0, 0],
        });
      }
      const fits = dots.filter((d) => d.col >= 0);
      const perRing = Math.ceil(fits.length / 2);
      fits.forEach((d, i) => { d.ring = i % 2; d.ringPos = Math.floor(i / 2) / perRing; });

      // Theme colours.
      let cA: RGB = [255, 45, 120];
      let cB: RGB = [192, 38, 211];
      let cC: RGB = [0, 229, 255];
      let cMuted: RGB = [134, 129, 122];
      let cText: RGB = [242, 237, 230];
      const hex = (v: string, fallback: RGB): RGB => {
        const m = v.trim().match(/^#([0-9a-f]{6})$/i);
        if (!m) return fallback;
        const n = parseInt(m[1], 16);
        return [n >> 16, (n >> 8) & 255, n & 255];
      };
      const mix = (a: RGB, b: RGB, t: number): RGB => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];
      const grad = (u: number): RGB => (u < 0.5 ? mix(cA, cB, u * 2) : mix(cB, cC, (u - 0.5) * 2));
      const readColours = () => {
        const cs = getComputedStyle(document.documentElement);
        cA = hex(cs.getPropertyValue('--color-cta-start'), cA);
        cB = hex(cs.getPropertyValue('--color-cta-mid'), cB);
        cC = hex(cs.getPropertyValue('--color-cta-end'), cC);
        cMuted = hex(cs.getPropertyValue('--color-text-muted'), cMuted);
        cText = hex(cs.getPropertyValue('--color-text'), cText);
        for (const d of dots) {
          d.noise = grad(d.u);
          d.rgb = d.col >= 0 ? grad((d.col / 4) * 0.85 + d.u * 0.15) : cMuted;
        }
      };
      readColours();
      new MutationObserver(readColours).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

      // Geometry. The action sits right of the copy on wide screens and
      // above it on phones.
      let W = 0;
      let H = 0;
      let dpr = 1;
      let narrow = false;
      let ready = false;
      const box = { x0: 0, y0: 0, x1: 0, y1: 0 };
      const resize = () => {
        const r = stage.getBoundingClientRect();
        W = r.width;
        H = r.height;
        narrow = W < 768;
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        if (narrow) {
          box.x0 = W * 0.09; box.x1 = W * 0.91; box.y0 = H * 0.12; box.y1 = H * 0.42;
        } else {
          box.x0 = W * 0.55; box.x1 = Math.min(W * 0.94, W - 40); box.y0 = H * 0.2; box.y1 = H * 0.78;
        }
        // Sizing a canvas clears it, so repaint straight away.
        if (ready) draw(performance.now());
      };
      resize();
      new ResizeObserver(resize).observe(stage);

      const clamp = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
      const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
      const ease = (t: number) => t * t * (3 - 2 * t);
      const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

      let target = 0;
      let smooth = 0;
      let pos = 0;
      const measure = () => {
        const r = scene.getBoundingClientRect();
        const travel = r.height - window.innerHeight;
        target = travel > 0 ? clamp(-r.top / travel) : 0;
      };

      // Keyboard users tab into panels that are faded out. Bring the
      // matching beat on screen when one takes focus.
      const HOLDS = [0, 0.38, 0.68, 0.96];
      panels.forEach((el, i) => {
        el.addEventListener('focusin', () => {
          if (Math.abs(pos - i) < 0.4) return;
          const r = scene.getBoundingClientRect();
          window.scrollTo({ top: window.scrollY + r.top + HOLDS[i] * (r.height - window.innerHeight), behavior: 'instant' as ScrollBehavior });
        });
      });

      const corner = (x: number, y: number, dx: number, dy: number, len: number) => {
        ctx.beginPath();
        ctx.moveTo(x + dx * len, y);
        ctx.lineTo(x, y);
        ctx.lineTo(x, y + dy * len);
        ctx.stroke();
      };

      let running = false;
      let raf = 0;
      let last = 0;
      const frame = (now: number) => {
        if (!running) return;
        raf = requestAnimationFrame(frame);
        draw(now);
      };
      const draw = (now: number) => {
        measure();
        // Ease towards the scroll position by elapsed time, so the motion
        // feels the same at any frame rate.
        const dt = last ? Math.min((now - last) / 1000, 1) : 1;
        last = now;
        smooth += (target - smooth) * (1 - Math.exp(-dt * 9));
        if (Math.abs(target - smooth) < 0.0004) smooth = target;

        const t = now / 1000;
        const t1 = seg(smooth, 0.13, 0.31);
        const t2 = seg(smooth, 0.43, 0.61);
        const t3 = seg(smooth, 0.73, 0.9);
        pos = t1 + t2 + t3;

        // Copy panels cross-fade around their beat.
        panels.forEach((el, i) => {
          const d = pos - i;
          const o = clamp(1 - Math.abs(d) * 2.4);
          el.style.opacity = o.toFixed(3);
          el.style.setProperty('--dy', `${(-d * 44).toFixed(1)}px`);
          el.style.pointerEvents = o > 0.6 ? 'auto' : 'none';
        });
        const active = Math.round(pos);
        ticks.forEach((el, i) => el.classList.toggle('is-active', i === active));
        if (fill) fill.style.width = `${(smooth * 100).toFixed(2)}%`;
        if (hint) hint.style.opacity = clamp(1 - t1 * 3).toFixed(2);

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, W, H);

        const bw = box.x1 - box.x0;
        const bh = box.y1 - box.y0;
        const gap = narrow ? 10 : Math.max(9, Math.min(12, bw / 42));
        const perRow = narrow ? 5 : 6;
        const colW = bw / 5;
        const baseY = box.y1 - (narrow ? 22 : 34);
        const cx = box.x0 + bw / 2;
        const cy = box.y0 + bh / 2;
        const R = Math.min(bw * 0.34, bh * 0.27);
        const bokeh = narrow ? 9 : 15;
        // Soft dots sit quieter behind the copy than beside it.
        const quiet = (x: number) => (narrow ? 0.55 : 0.32 + 0.68 * ease(clamp((x - W * 0.42) / (W * 0.3))));

        for (const d of dots) {
          const e1 = ease(clamp(t1 * 1.35 - d.delay));
          const x0 = d.nx * W;
          const y0 = d.ny * H;
          const drift = 14 * d.depth;
          let x: number;
          let y: number;
          let radius: number;
          let alpha: number;
          let rgb: RGB;
          const soft = 0.07 + d.depth * 0.13;

          if (d.col < 0) {
            // Not a fit. Stays soft, drifts out and fades.
            const e2 = ease(clamp(t2 * 1.35 - d.delay));
            x = x0 + (x0 - W / 2) * 0.08 * e1 + Math.sin(t * 0.25 + d.phase) * drift;
            y = y0 + (y0 - H / 2) * 0.08 * e1 + Math.cos(t * 0.21 + d.phase) * drift;
            radius = 3 + d.depth * bokeh;
            alpha = soft * quiet(x) * (1 - 0.6 * e1) * (1 - 0.7 * e2);
            rgb = mix(d.noise, cMuted, e1);
          } else {
            const e2 = ease(clamp(t2 * 1.35 - d.delay));
            const e3 = ease(clamp(t3 * 1.35 - d.delay));
            const x1 = box.x0 + (0.06 + 0.88 * d.ax) * bw;
            const y1 = box.y0 + (0.1 + 0.8 * d.ay) * bh;
            const x2 = box.x0 + colW * (d.col + 0.5) + ((d.slot % perRow) - (perRow - 1) / 2) * gap;
            const y2 = baseY - Math.floor(d.slot / perRow) * gap;
            const dir = d.ring ? -1 : 1;
            const ang = d.ringPos * Math.PI * 2 + t * 0.2 * dir;
            const rr = R + d.jitter * 7;
            const x3 = cx + Math.cos(ang) * rr;
            const y3 = cy + (d.ring ? R * 0.57 : -R * 0.57) + Math.sin(ang) * rr;
            const calm = 1 - 0.75 * e1 - 0.25 * e2;
            x = lerp(lerp(lerp(x0, x1, e1), x2, e2), x3, e3) + Math.sin(t * 0.25 + d.phase) * drift * calm;
            y = lerp(lerp(lerp(y0, y1, e1), y2, e2), y3, e3) + Math.cos(t * 0.21 + d.phase) * drift * calm;
            const sharp = narrow ? (d.col === 4 ? 2.8 : 2.1) : d.col === 4 ? 3.4 : 2.6;
            radius = lerp(3 + d.depth * bokeh, sharp, e1);
            alpha = lerp(soft * quiet(x), 0.95, e1);
            rgb = mix(d.noise, d.rgb, e1);
          }

          if (alpha < 0.006) continue;
          ctx.beginPath();
          ctx.arc(x, y, radius, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${rgb[0] | 0},${rgb[1] | 0},${rgb[2] | 0},${alpha.toFixed(3)})`;
          ctx.fill();
          if (radius > 6) {
            ctx.lineWidth = 1;
            ctx.strokeStyle = `rgba(${rgb[0] | 0},${rgb[1] | 0},${rgb[2] | 0},${(alpha * 1.4).toFixed(3)})`;
            ctx.stroke();
          }
        }

        // Viewfinder brackets. They frame the whole stage at first, then
        // close on the action as the focus pulls.
        const eb = ease(t1);
        const pad = narrow ? 14 : 22;
        const inset = narrow ? 14 : 28;
        const bx0 = lerp(inset, box.x0 - pad, eb);
        const by0 = lerp(inset, box.y0 - pad, eb);
        const bx1 = lerp(W - inset, box.x1 + pad, eb);
        const by1 = lerp(H - inset, box.y1 + pad, eb);
        const len = narrow ? 12 : 18;
        ctx.lineWidth = 1.5;
        ctx.strokeStyle = `rgba(${cText[0]},${cText[1]},${cText[2]},${lerp(0.22, 0.5, eb).toFixed(2)})`;
        corner(bx0, by0, 1, 1, len);
        corner(bx1, by0, -1, 1, len);
        corner(bx0, by1, 1, -1, len);
        corner(bx1, by1, -1, -1, len);

        // Captions and stage labels, set in the site's mono face.
        const mono = getComputedStyle(document.documentElement).getPropertyValue('--font-mono') || 'monospace';
        const size = narrow ? 8.5 : 11;
        ctx.font = `500 ${size}px ${mono}`;
        (ctx as CanvasRenderingContext2D & { letterSpacing?: string }).letterSpacing = narrow ? '1px' : '2.4px';
        ctx.textBaseline = 'top';
        ctx.textAlign = 'left';
        CAPTIONS.forEach((label, i) => {
          if (i === 0) return;
          const o = clamp(1 - Math.abs(pos - i) * 2.2);
          if (o <= 0.01) return;
          ctx.fillStyle = `rgba(${cText[0]},${cText[1]},${cText[2]},${(o * 0.75).toFixed(2)})`;
          ctx.fillText(label.toUpperCase(), bx0 + len + 6, by0 + 1);
        });
        const lo = clamp(1 - Math.abs(pos - 2) * 2.2);
        if (lo > 0.01) {
          ctx.textAlign = 'center';
          ctx.strokeStyle = `rgba(${cText[0]},${cText[1]},${cText[2]},${(lo * 0.18).toFixed(2)})`;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(box.x0, baseY + gap);
          ctx.lineTo(box.x1, baseY + gap);
          ctx.stroke();
          STAGES.forEach((label, c) => {
            const on = c === 4;
            ctx.fillStyle = on
              ? `rgba(${cC[0]},${cC[1]},${cC[2]},${lo.toFixed(2)})`
              : `rgba(${cText[0]},${cText[1]},${cText[2]},${(lo * 0.6).toFixed(2)})`;
            ctx.fillText(label.toUpperCase(), box.x0 + colW * (c + 0.5), baseY + gap + (narrow ? 7 : 10));
          });
        }
      };

      ready = true;
      draw(performance.now());
      const start = () => { if (!running) { running = true; last = 0; raf = requestAnimationFrame(frame); } };
      const stop = () => { running = false; cancelAnimationFrame(raf); };
      new IntersectionObserver((entries) => {
        entries.forEach((e) => (e.isIntersecting && !document.hidden ? start() : stop()));
      }, { rootMargin: '10% 0px 10% 0px' }).observe(scene);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else if (scene.getBoundingClientRect().bottom > 0 && scene.getBoundingClientRect().top < window.innerHeight) start();
      });
    }
  }
</script>
