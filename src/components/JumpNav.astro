---
// "Jump to" row for long hand-written pages. Pass the section ids and
// short labels. Each target h2 needs a matching id.
interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
---
<nav class="jump-nav" aria-label="Jump to a section">
  <div class="container">
    <p class="jump-label mono">JUMP TO</p>
    <ul class="jump-list">
      {items.map(i => <li><a href={`#${i.id}`}>{i.label}</a></li>)}
    </ul>
  </div>
</nav>

<style>
  .jump-nav {
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding-block: var(--space-sm);
    background: var(--color-bg-alt);
  }
  .jump-label {
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    color: var(--color-text-secondary);
    margin-bottom: 0.5rem;
  }
  .jump-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0;
  }
  .jump-list a {
    display: inline-block;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: 1.3;
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .jump-list a:hover,
  .jump-list a:focus-visible {
    color: var(--color-text);
    border-color: var(--color-cta-start);
  }
</style>
