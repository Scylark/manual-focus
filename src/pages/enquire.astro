---
// Old enquiry URL. Every link now points at /contact/; this page forwards
// anyone arriving from an older link, keeping ?offer= and the other
// pre-fill parameters the contact form reads.
import { url } from '../utils/paths';
const target = url('/contact/');
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL('/contact/', Astro.site).href} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Contact Manual Focus</title>
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.search + location.hash);
    </script>
  </head>
  <body>
    <p>This page has moved to <a href={target}>the contact page</a>.</p>
  </body>
</html>
