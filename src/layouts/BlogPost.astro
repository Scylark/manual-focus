---
import Base from './Base.astro';
import SEOHead from '../components/SEOHead.astro';
import PostPlayer from '../components/PostPlayer.astro';
import { transcript } from '../utils/podcast';
import { url } from '../utils/paths';
import { formatTag, isListed } from '../utils/blog';
import { getCollection } from 'astro:content';

interface HowToStep { name: string; text: string }
interface PostRef { slug: string; title: string }
interface FaqItem { question: string; answer: string }
interface Source { title: string; url: string; publisher?: string }

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags: string[];
  image?: string;
  howToName?: string;
  howToSteps?: HowToStep[];
  faq?: FaqItem[];
  sources?: Source[];
  minutes?: number;
  podcast?: { audio: string; duration: number; bytes: number; published?: Date; youtube?: string };
  slug?: string;
  unlisted?: boolean;
  newerPost?: PostRef | null;
  olderPost?: PostRef | null;
}

const { title, description, date, updated, tags, image, howToName, howToSteps, faq, sources, minutes, podcast, slug, unlisted, newerPost, olderPost } = Astro.props;

// Show notes for the episode, written alongside its script in podcast/notes/.
const showNotes = import.meta.glob<{ Content: any }>('/podcast/notes/*.md', { eager: true });
const ShowNotes = podcast && slug ? showNotes[`/podcast/notes/${slug}.md`]?.Content : undefined;
// The words of the episode, as text on the page, so search and answer engines
// can read what was said.
const turns = podcast && slug ? transcript(slug) : undefined;
const formattedDate = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const formattedUpdated = updated && updated.getTime() !== date.getTime()
  ? updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog' },
  { name: title, url: Astro.url.pathname },
];

// Related posts — rank other posts by shared-tag count, exclude current,
// take top 3. Gives Google internal link signals for topical authority
// and keeps readers moving through the content.
const allPosts = await getCollection('blog', isListed);
const related = allPosts
  .filter(p => p.data.title !== title)
  .map(p => ({
    post: p,
    score: p.data.tags.filter(t => tags.includes(t)).length,
  }))
  .filter(x => x.score > 0)
  .sort((a, b) =>
    b.score - a.score ||
    new Date(b.post.data.date).getTime() - new Date(a.post.data.date).getTime()
  )
  .slice(0, 3)
  .map(x => x.post);
---
<Base title={title} description={description} noindex={unlisted} ogImage={image} ogType="article" publishedTime={date} modifiedTime={updated ?? date}>
  <SEOHead slot="seo" type="article" title={title} description={description} publishDate={date} modifiedDate={updated} tags={tags} image={image} breadcrumbs={breadcrumbs} howToName={howToName} howToSteps={howToSteps} articleFaq={faq} sources={sources} podcast={podcast && slug ? { ...podcast, slug } : undefined} />

  <article class="section">
    <div class="container prose">
      <header class="post-header">
        <p class="post-meta">
          <time datetime={date.toISOString()}>{formattedDate}</time>
          {minutes && <span class="post-minutes">· {minutes} min read</span>}
          {formattedUpdated && updated && <span class="post-minutes">· Updated <time datetime={updated.toISOString()}>{formattedUpdated}</time></span>}
        </p>
        <h1>{title}</h1>
        <p class="post-byline">By <a href={url('/about/')} rel="author">James Vickers</a>, Manual Focus</p>
        <div class="post-tags">
          {tags.map(tag => (
            <a href={url(`/blog/tag/${tag}/`)} class="tag">{formatTag(tag)}</a>
          ))}
        </div>
        {podcast && <PostPlayer audio={podcast.audio} duration={podcast.duration} />}
      </header>

      <div class="post-content">
        <slot />

        {/* Rendered from frontmatter with plain h2/h3/p/ul so they pick up
            the same .post-content styles as the markdown above. */}
        {faq && faq.length > 0 && (
          <section aria-labelledby="faq-heading">
            <h2 id="faq-heading">Frequently asked questions</h2>
            {faq.map(item => (
              <>
                <h3>{item.question}</h3>
                <p>{item.answer}</p>
              </>
            ))}
          </section>
        )}

        {sources && sources.length > 0 && (
          <section aria-labelledby="sources-heading">
            <h2 id="sources-heading">Sources</h2>
            <ul>
              {sources.map(src => (
                <li>
                  <a href={src.url} rel="noopener">{src.title}</a>{src.publisher && `, ${src.publisher}`}
                </li>
              ))}
            </ul>
          </section>
        )}

        {(ShowNotes || turns) && (
          <section id="show-notes" class="show-notes" aria-labelledby="show-notes-heading">
            <h2 id="show-notes-heading">From the podcast</h2>
            {ShowNotes && <ShowNotes />}
            {turns && (
              <details id="transcript" class="transcript">
                <summary>Read the episode transcript</summary>
                {turns.map((t) => (
                  <p><strong>{t.speaker}:</strong> {t.text}</p>
                ))}
              </details>
            )}
          </section>
        )}
      </div>

      <footer class="post-footer">
        {(newerPost || olderPost) && (
          <nav class="post-nav" aria-label="Post navigation">
            {olderPost ? (
              <a href={url(`/blog/${olderPost.slug}/`)} class="post-nav-link post-nav-prev" rel="prev">
                <span class="post-nav-label mono">← OLDER</span>
                <span class="post-nav-title">{olderPost.title}</span>
              </a>
            ) : <span />}
            {newerPost ? (
              <a href={url(`/blog/${newerPost.slug}/`)} class="post-nav-link post-nav-next" rel="next">
                <span class="post-nav-label mono">NEWER →</span>
                <span class="post-nav-title">{newerPost.title}</span>
              </a>
            ) : <span />}
          </nav>
        )}
        <p class="post-next-step">
          Want this applied to your own team? <a href={url('/enquire/')}>Book a free working session</a>, or run the workflows yourself with <a href={url('/lens/')}>The Lens</a>.
        </p>
        <a href={url('/blog/')}>Back to all posts</a>
      </footer>
    </div>
  </article>

  {related.length > 0 && (
    <aside class="related-section">
      <div class="container">
        <h2 class="related-heading">Related reading</h2>
        <div class="related-grid">
          {related.map(post => (
            <a href={url(`/blog/${post.id}/`)} class="related-card">
              <p class="related-date">{new Date(post.data.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
              <h3 class="related-title">{post.data.title}</h3>
              <p class="related-desc">{post.data.description}</p>
              <span class="related-link">Read →</span>
            </a>
          ))}
        </div>
      </div>
    </aside>
  )}
</Base>

<script>
  // Opens the transcript when a link points at it (the player links to #transcript).
  const openTranscript = () => {
    const t = document.getElementById('transcript');
    if (location.hash === '#transcript' && t instanceof HTMLDetailsElement) t.open = true;
  };
  openTranscript();
  window.addEventListener('hashchange', openTranscript);

  // A copy button on each show-notes prompt.
  document.querySelectorAll<HTMLElement>('.show-notes pre').forEach((pre) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-prompt';
    button.textContent = 'Copy prompt';
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
      button.textContent = 'Copied';
      setTimeout(() => (button.textContent = 'Copy prompt'), 2000);
    });
    pre.append(button);
  });
</script>

<style>
  .post-header {
    margin-bottom: var(--space-lg);
  }

  .post-meta {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .post-minutes {
    color: var(--color-text-muted);
  }

  .post-byline {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin-top: var(--space-xs);
  }
  .post-byline a { color: var(--color-text); }

  .post-next-step {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
  }

  .post-header h1 {
    margin-top: var(--space-xs);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
  }

  .tag {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: 2px;
  }

  .tag:hover {
    color: var(--color-text);
    border-color: var(--color-text);
  }

  .post-content {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
  }

  .post-content :global(h2) {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  .post-content :global(h3) {
    margin-top: var(--space-md);
    margin-bottom: var(--space-xs);
  }

  .post-content :global(p) {
    margin-bottom: var(--space-sm);
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: var(--space-sm);
    padding-left: var(--space-md);
  }

  /* Tables in posts (comparisons, definitions, decision grids). Built from the
     site's tokens; on phones a wide table scrolls inside the column rather
     than widening the page. */
  /* Charts and images in a post scale down to the column instead of being clipped. */
  .post-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: var(--space-sm) 0 var(--space-md);
  }
  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-sm) 0 var(--space-md);
    font-size: 0.95em;
    line-height: 1.45;
  }
  .post-content :global(th),
  .post-content :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 10px 12px;
    border-bottom: 1px solid var(--color-line);
  }
  .post-content :global(thead th) {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border-bottom-color: var(--color-text-muted);
  }
  .post-content :global(tbody td:first-child) {
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .post-content :global(table) {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .post-content :global(th),
    .post-content :global(td) {
      min-width: 9.5rem;
    }
  }

  .post-footer {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-line);
  }

  /* Chronological prev/next — keeps readers inside the blog and gives
     crawlers a link path through the archive. */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }
  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: var(--space-sm);
    border: 1px solid var(--color-line);
    border-radius: 4px;
    text-decoration: none;
    transition: border-color 0.3s ease;
  }
  .post-nav-link:hover {
    border-color: var(--color-text);
  }
  .post-nav-next {
    text-align: right;
  }
  .post-nav-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
  }
  .post-nav-title {
    font-size: 0.95rem;
    line-height: 1.3;
    color: var(--color-text);
  }
  @media (min-width: 640px) {
    .post-nav { grid-template-columns: 1fr 1fr; }
  }

  /* Podcast show notes: the "Get AI on this" prompts render as code blocks.
     Wrap them so they fit the column, and give each a copy button. */
  .show-notes :global(pre) {
    position: relative;
    margin: var(--space-xs) 0 var(--space-md);
    padding: var(--space-sm);
    padding-top: 2.75rem;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    background: var(--color-card-bg) !important;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.8rem;
    line-height: 1.55;
  }
  .show-notes :global(pre code) {
    color: var(--color-text-secondary) !important;
  }
  .show-notes :global(pre code span) {
    color: inherit !important;
  }
  .show-notes :global(.copy-prompt) {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    padding: 0.3rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: 2px;
    cursor: pointer;
  }
  /* Episode transcript: closed by default, but in the HTML for crawlers. */
  .transcript {
    margin: var(--space-md) 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  .transcript summary {
    padding: var(--space-sm) 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    cursor: pointer;
  }
  .transcript summary:hover { color: var(--color-text); }
  .transcript p {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
  }
  .transcript strong { color: var(--color-text); font-weight: 600; }

  .show-notes :global(.copy-prompt:hover) {
    color: var(--color-text);
    border-color: var(--color-text);
  }

  /* Related reading — internal-link block under each post for topical
     authority and to keep readers moving through the content. */
  .related-section {
    padding-block: var(--space-xl);
    border-top: 1px solid var(--color-line);
    background: var(--color-bg-alt);
  }
  .related-heading {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin-bottom: var(--space-md);
  }
  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md);
    border: 1px solid var(--color-line);
    border-radius: 4px;
    background: var(--color-bg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .related-card:hover {
    border-color: var(--color-text);
    transform: translateY(-3px);
  }
  .related-date {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
  }
  .related-title {
    font-size: 1.1rem;
    line-height: 1.25;
    margin: 0;
    color: var(--color-text);
  }
  .related-desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.45;
    margin: 0;
    flex: 1;
  }
  .related-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-cta-start);
    margin-top: var(--space-sm);
  }
  @media (min-width: 720px) {
    .related-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
