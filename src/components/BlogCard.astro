---
import { url } from '../utils/paths';
interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  minutes?: number;
  listenMinutes?: number; // set when the post has a podcast episode
}
const { title, description, date, slug, minutes, listenMinutes } = Astro.props;
const formattedDate = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<article class="blog-card">
  {listenMinutes && (
    <span class="blog-card-listen" title="This post has a podcast episode">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 14v-2a8 8 0 0 1 16 0v2" /><rect x="3" y="14" width="4" height="6" rx="1.5" /><rect x="17" y="14" width="4" height="6" rx="1.5" /></svg>
      <span>Listen · {listenMinutes} min</span>
    </span>
  )}
  <p class="blog-card-meta">
    <time datetime={date.toISOString()}>{formattedDate}</time>
    {minutes && <span class="blog-card-minutes">· {minutes} min read</span>}
  </p>
  <h3><a href={url(`/blog/${slug}/`)}>{title}</a></h3>
  <p>{description}</p>
</article>

<style>
  .blog-card {
    padding: var(--space-md);
    border: 1px solid var(--color-line);
    border-radius: 4px;
    background: var(--color-bg);
    position: relative;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.3s ease;
  }

  .blog-card::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 5px;
    background: var(--color-cta-gradient);
    opacity: 0;
    z-index: -1;
    transition: opacity 0.3s ease;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px var(--ring-shadow);
    border-color: transparent;
  }

  .blog-card:hover::before {
    opacity: 1;
  }

  /* On hover the gradient sits behind the text (the transform above puts
     ::before in the card's stacking context), so the grey text tokens
     become unreadable. A 35% dark tint over the gradient plus white text
     keeps every part of the card at 5.2:1 or better in both themes. */
  .blog-card::before {
    background: linear-gradient(rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.35)), var(--color-cta-gradient);
  }
  .blog-card:hover .blog-card-meta,
  .blog-card:hover .blog-card-minutes,
  .blog-card:hover h3 a,
  .blog-card:hover p {
    color: #fff;
  }

  .blog-card-meta {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  /* Podcast badge, above the date on cards whose post has an episode. */
  .blog-card-listen {
    display: inline-flex;
    margin-bottom: 0.75rem;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-cta-start);
    border: 1px solid currentColor;
    border-radius: 2px;
  }
  .blog-card-listen svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  .blog-card:hover .blog-card-listen {
    color: #fff;
  }

  .blog-card-minutes {
    color: var(--color-text-muted);
  }

  .blog-card h3 {
    margin-top: var(--space-xs);
    font-size: var(--font-size-body);
    line-height: 1.3;
  }

  .blog-card h3 a {
    text-decoration: none;
  }

  .blog-card h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .blog-card p {
    margin-top: var(--space-xs);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }
</style>
