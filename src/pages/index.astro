    /* Section headlines down a notch */
    .big-statement { font-size: clamp(1.875rem, 9vw, 3rem); }
    .logos-headline { font-size: clamp(1.625rem, 7vw, 2.5rem); }
    .cta-headline { font-size: clamp(1.75rem, 8vw, 3rem); }

    /* /02 way-num row — allow MOST CHOSEN pill to wrap below the label
       instead of squashing /02 · FRACTIONAL CMO onto two lines */
    .way-num { flex-wrap: wrap; row-gap: 0.5rem; }

    /* CTA close — less vertical padding */
    .cta-close { padding-block: var(--space-xl); }
    .cta-sub { font-size: 1rem; }

    /* Bigger touch targets on buttons */
    .btn-cta, .btn-ghost { padding: 0.85rem 1.4rem; font-size: 0.85rem; }
    .way-cta { padding: 0.6rem 1.2rem; }

    /* Problem section — single column reads better on mobile */
    .problem-copy { font-size: 1rem; }
  }

  /* Short phones, such as a 375 by 553 screen with the browser
     toolbars showing. The headline and the lead come down so both
     calls to action stay on the first screen. */
  @media (max-width: 768px) and (max-height: 620px) {
    .hero-headline { font-size: 1.75rem; }
    .hero-sub { font-size: 0.95rem; line-height: 1.5; }
    .hero-meta { margin-top: var(--space-sm); }
  }

  /* Even tighter on the smallest phones */
  @media (max-width: 380px) {
    .container { padding-inline: var(--space-sm); }
    .hero-headline { font-size: clamp(2rem, 10vw, 3rem); }
  }
  @media (max-width: 380px) and (max-height: 620px) {
    .hero-headline { font-size: 1.75rem; }
  }

  /* ============================
     INTERMEDIATE — tablet portrait/landscape and small laptops
     (769–1024px). Previously the site had a hard cut at 768px:
     below = mobile rules, above = full desktop layout. That left
     iPads and 13" laptops getting desktop type sizes calibrated for
     a 1440+ canvas, which read oversized in the smaller viewport.
     This band tightens type and gutters without flipping to the
     mobile layout (sticky dwell-pin etc. still works in this band).
     ============================ */
  @media (min-width: 769px) and (max-width: 1024px) {
    .hero-headline { font-size: clamp(2.5rem, 6vw, 4rem); }
    .big-statement { font-size: clamp(2.25rem, 6vw, 3.5rem); }
    .logos-headline { font-size: clamp(1.75rem, 4.5vw, 2.5rem); }
    .cta-headline { font-size: clamp(2rem, 5.5vw, 3.25rem); }

    /* Tighter section gutters so content doesn't hug edge-padding
       designed for a 1280+ canvas. */
    .container { padding-inline: var(--space-md); }

    /* Way-cards stay 3-column but with tighter padding so the cards
       don't feel stretched on a narrower viewport. */
    .way-card { padding: var(--space-md); }
  }

  /* Short-viewport guard. The hero block (headline + sub + CTAs)
     lives inside a 100svh stage with overflow:hidden. The headline is
     sized off vw, so a short-but-wide window (laptop with docked
     browser, external ultrawide) blows the block past the stage edge
     and clips the CTAs. Below 860px of height the headline keys off
     vh instead, shrinking the whole block to fit. These rules sit
     after the tablet band above, which otherwise outranks them on a
     window such as 1000 by 545. Phones have their own rules above.
     Short windows also take the short lead, as on the business page. */
  @media (max-height: 860px) and (min-width: 769px) {
    .hero-headline {
      font-size: clamp(1.5rem, 5vh, 3.25rem);
    }
    .hero-sub {
      font-size: clamp(0.95rem, 2.3vh, 1.15rem);
    }
    .hero-meta {
      margin-top: var(--space-sm);
    }
  }
  @media (max-height: 700px) and (min-width: 769px) {
    .hero-headline {
      font-size: clamp(1.5rem, 6.4vh, 2.6rem);
    }
    .hero-ctas .btn-cta, .hero-ctas .btn-ghost { padding: 0.8rem 1.5rem; font-size: 0.9rem; }
  }

  /* ============================
     THE METHOD. The business page's strand layout: a lead, a figure
     from the diagram system, three way-cards, a note. Plain section.
     ============================ */
  .method-section { overflow: hidden; position: relative; }
  .method-section > .container { position: relative; z-index: 2; }
  .method-h2 {
    font-size: clamp(2rem, 5vw, 4rem);
    max-width: 1000px;
    position: relative;
    z-index: 2;
  }
  .home-h3 {
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    margin-bottom: var(--space-xs);
  }
  .method-copy {
    margin-top: var(--space-md);
    color: var(--color-text-secondary);
    font-size: var(--font-size-lg);
    line-height: 1.6;
    max-width: 760px;
    position: relative;
    z-index: 2;
  }
  .method-note {
    margin-top: var(--space-md);
    color: var(--color-text-secondary);
    max-width: 760px;
    line-height: 1.6;
    position: relative;
    z-index: 2;
  }
  .method-note a,
  .logos-note a,
  .home-table a {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-cta-start);
    text-underline-offset: 0.2em;
  }
  .method-figure { margin-top: var(--space-lg); max-width: 1000px; position: relative; z-index: 2; }
  .method-figure :global(.dg) { margin: 0; }
  /* The figure's own table. The blog layout styles post tables, so the
     same rules come along here. */
  .method-figure :global(table) {
    width: 100%;
    border-collapse: collapse;
    line-height: 1.45;
  }
  .method-figure :global(th),
  .method-figure :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 10px 12px;
    border-bottom: 1px solid var(--color-line);
    color: color-mix(in srgb, var(--color-text) 86%, transparent);
  }
  .method-figure :global(thead th) {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
    border-bottom-color: color-mix(in srgb, var(--color-text) 45%, transparent);
  }
  .method-figure :global(tbody td:first-child) { font-weight: 600; color: var(--color-text); }
  .method-section .ways-grid { margin-top: var(--space-lg); }
  .method-section .way-for { flex: 1; }
  .method-section .way-card:hover { background: var(--color-bg); }

  /* ============================
     TABLES. The situation table from the business page, with the
     contrast lift: full text colour, bold first column, mono header.
     ============================ */
  .home-table-title { margin-top: var(--space-lg); position: relative; z-index: 2; }
  .home-table-wrap { max-width: 1000px; overflow-x: auto; position: relative; z-index: 2; }
  .home-table {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-sm) 0 0;
    font-size: var(--font-size-body);
  }
  .home-table th,
  .home-table td {
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 16%, transparent);
    padding: 0.85rem 0.75rem;
    text-align: left;
    color: color-mix(in srgb, var(--color-text) 86%, transparent);
    line-height: 1.5;
    vertical-align: top;
  }
  .home-table th {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text);
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 45%, transparent);
    padding-bottom: 0.65rem;
  }
  .home-table td:first-child { color: var(--color-text); font-weight: 600; }
  .home-table strong { color: var(--color-text); }

  /* ============================
     NUMBER CARDS. The About page's figures, compact, under the three
     result cards.
     ============================ */
  .numbers-grid {
    margin-top: var(--space-md);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
    position: relative;
    z-index: 2;
  }
  .number-card {
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-line);
    border-radius: 4px;
    background: var(--color-card-bg);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.35rem var(--space-sm);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .number-card:hover { border-color: var(--color-text); transform: translateY(-3px); }
  .number-value {
    font-family: var(--font-display);
    line-height: 0.95;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
  }
  .num-prefix {
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    color: var(--color-text-muted);
    letter-spacing: -0.02em;
  }
  .num-main {
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    background: var(--color-cta-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.02em;
  }
  .number-label {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: 1.4;
  }
  @media (min-width: 640px) {
    .numbers-grid { grid-template-columns: repeat(3, 1fr); gap: var(--space-sm); }
  }

  /* The short lead shows on phones and short desktop windows, so the
     hero fits the first screen. */
  .lead-short { display: none; }
  @media (max-width: 768px), (max-height: 700px) {
    .lead-full { display: none; }
    .lead-short { display: inline; }
  }

  /* The rings in the detail sections only show where there is clear
     space beside the copy. On anything narrower they would sit behind
     the text and wash it out. The hero and the closing section keep
     theirs at every size. */
  @media (max-width: 1399px) {
    .method-section > :global(.focus-object),
    .ways-section > :global(.focus-object),
    .problem-section :global(.focus-object),
    .blog-section :global(.focus-object) { display: none; }
  }

  @media (max-width: 768px) {
    .method-h2 { font-size: clamp(1.75rem, 7vw, 2.5rem); }
    .method-copy { font-size: 1rem; }
    .number-card { padding: 0.85rem 0.9rem; }

    /* Tables read as stacked entries, each cell under its own label. */
    .home-table-wrap { overflow: visible; }
    .home-table thead { display: none; }
    .home-table, .home-table tbody, .home-table tr, .home-table td { display: block; }
    .home-table tr { padding: 0.95rem 0; border-bottom: 1px solid color-mix(in srgb, var(--color-text) 16%, transparent); }
    .home-table td { border: 0; padding: 0; font-size: 0.95rem; line-height: 1.45; }
    .home-table td:first-child { color: var(--color-text); font-weight: 600; font-size: 1rem; }
    .home-table td[data-label] { margin-top: 0.55rem; }
    .home-table td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-family: var(--font-mono);
      font-size: 0.6rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--color-text-secondary);
      margin-bottom: 0.1rem;
    }
  }

  /* ============================
     DWELL-PIN — sections that should hold the visitor's eye briefly
     as they scroll past. Same pattern as the hero and manifesto:
     the section is tall, the content inside is sticky-pinned at the
     top of the viewport for the duration of the pin. Combined with
     the scroll-driven reveal in Base.astro, the visitor sees the
     headline + body fade up into place during the section approach,
     then HOLD in view for ~100vh of pinned scroll before the section
     releases and the next one slides up. The vertical movement
     genuinely pauses for a moment even while the scroll wheel keeps
     spinning. Mobile drops the pin entirely — adds too much page
     length on a phone for too little visual payoff.
     ============================ */
  .section.dwell-pin,
  .dwell-pin {
    /* Section height = stage's natural height + a trailing pad that
       provides the pin range. Using a ::after trailer instead of
       min-height means tall content (like the 3 stacked way-cards
       on mobile) still gets a consistent dwell-pin range — with
       min-height alone, when the stage's content exceeded the
       section min-height, the pin range collapsed to zero. */
    padding-block: 0;
    position: relative;
    background: var(--color-bg);
    overflow: visible;
  }
  .dwell-pin::after {
    content: "";
    display: block;
    /* 50vh on desktop = the dwell-pin pin duration. Half a viewport
       of scroll runway. Long enough for the brain to register a
       pause, short enough that the empty section bg scrolling past
       doesn't read as dead space. Was 100vh (still felt long) and
       220vh originally (definitely too long). */
    height: 50vh;
    background: inherit;
  }
  .dwell-pin-stage {
    position: sticky;
    top: 0;
    /* 100svh stage so it fills the viewport while pinned. Content
       centred inside, so a section with less content has equal
       top/bottom breathing room. Padding tightened from --space-2xl
       to --space-lg so content sits closer to viewport edges during
       the pin — less empty space above/below the headline + body. */
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: var(--space-lg);
    width: 100%;
    background: var(--color-bg);
    /* Clip FocusObjects + other absolutely-positioned decoration
       inside the stage instead of on the section (which would break
       the sticky behaviour). */
    overflow: hidden;
  }
  .dwell-pin-stage > .container { width: 100%; }
  /* Section variants that have their own background colour need to
     pass that through to the dwell-pin sticky stage too, otherwise
     during the exit phase the stage's bg differs from the section's
     and you get a visible colour seam. */
  .section.section-alt.dwell-pin,
  .section.section-alt.dwell-pin .dwell-pin-stage {
    background: var(--color-bg-alt, var(--color-bg));
  }
  @media (max-width: 768px) {
    /* ============================
       MOBILE — dwell-pin sticky pattern mirrors desktop using the
       ::after trailer technique. The trailer pads each dwell-pin's
       height by a fixed amount on top of the stage's natural height,
       which is the only way to guarantee a perceptible pin range
       when stage content is taller than the viewport (e.g. the
       ways-cards-pin holds 3 stacked cards = ~2400px on a phone, so
       a static min-height pin range would collapse to zero). With
       the trailer, pin range stays constant at 60–80vh regardless
       of stage height.

       overflow-x:clip on every section catches any 3D-transform
       bleed without becoming a scroll container — sticky inside
       still resolves to the viewport. (hidden would break sticky.)
       ============================ */
    .section {
      overflow-x: clip;
    }
    .section.dwell-pin,
    .dwell-pin {
      padding-block: 0;
    }
    .section.dwell-pin::after {
      height: 80vh;
    }
    .dwell-pin:not(.section)::after {
      height: 60vh;
    }
  }
</style>

<script>
  // Hero parallax — subtle mouse tracking on desktop
  const parallaxEls = document.querySelectorAll<HTMLElement>('[data-parallax]');

  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.addEventListener('mousemove', (e) => {
      const x = (e.clientX / window.innerWidth - 0.5);
      const y = (e.clientY / window.innerHeight - 0.5);
      parallaxEls.forEach(el => {
        el.style.transform = `translate3d(${x * -10}px, ${y * -6}px, 0)`;
      });
    }, { passive: true });
  }

  // Manifesto — scroll-scrubbed animation. Each line owns 1/total of the
  // scrollable section. We compute that line's "slot progress" (-∞..+∞,
  // 0 = perfectly centred) and drive opacity, X translation and blur
  // directly from that value every frame, so the motion glides with the
  // scroll rather than triggering at thresholds.
  const manifestoSection = document.querySelector<HTMLElement>('[data-manifesto]');
  const manifestoLines = document.querySelectorAll<HTMLElement>('.manifesto-line');
  if (manifestoSection && manifestoLines.length) {
    const total = manifestoLines.length;
    // Reduced motion: lines still cross-fade on scroll, without the blur,
    // depth and skew.
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let manifestoPending = false;
    const updateManifesto = () => {
      const rect = manifestoSection.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      const progress = scrollable > 0
        ? Math.max(0, Math.min(1, -rect.top / scrollable))
        : 0;
      manifestoLines.forEach((line, i) => {
        // slot = where this pledge sits in scroll progress.
        // slot < -HOLD_BAND: entering from far away
        // -HOLD_BAND <= slot <= HOLD_BAND: HOLDING at sharp focus,
        //   no transform, full opacity — true dwell
        // slot > HOLD_BAND: exiting toward camera
        const slot = progress * total - i - 0.5;
        const clamped = Math.max(-1.2, Math.min(1.2, slot));

        // 70% of each pledge's slot is the hold zone where it sits
        // sharp + static. 15% on each side is enter/exit transition.
        const HOLD_BAND = 0.35;

        // Phase: -1 (far behind) ... 0 (in hold) ... +1 (far past)
        let phase = 0;
        if (clamped < -HOLD_BAND) {
          phase = (clamped + HOLD_BAND) / (1 - HOLD_BAND);
        } else if (clamped > HOLD_BAND) {
          phase = (clamped - HOLD_BAND) / (1 - HOLD_BAND);
        }
        const absPhase = Math.abs(phase);

        // Opacity holds at 1 through the hold zone, drops smoothly
        // in the transitions.
        const opacity = 1 - absPhase * absPhase * (3 - 2 * absPhase);

        // Phase drives ALL motion. During hold (phase=0) every value
        // is 0 = pledge sits perfectly still at the focal point.
        const x = -phase * 30;
        const z = phase * 500;
        const rotX = phase * -12;
        const skew = -phase * 1.5;
        const blur = absPhase * 16;

        line.style.opacity = opacity.toFixed(3);
        if (calm) return;
        line.style.transform =
          `translate3d(${x.toFixed(1)}px, 0, ${z.toFixed(1)}px)` +
          ` rotateX(${rotX.toFixed(2)}deg) skewX(${skew.toFixed(2)}deg)`;
        line.style.filter = `blur(${blur.toFixed(1)}px)`;
      });
      manifestoPending = false;
    };
    window.addEventListener('scroll', () => {
      if (!manifestoPending) {
        manifestoPending = true;
        requestAnimationFrame(updateManifesto);
      }
    }, { passive: true });
    updateManifesto();
  }

  // Scroll-scale headlines — grow as they approach centre of viewport
  const scaleEls = document.querySelectorAll<HTMLElement>('[data-scroll-scale]');
  if (scaleEls.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let scalePending = false;
    const updateScale = () => {
      const vh = window.innerHeight;
      scaleEls.forEach(el => {
        const rect = el.getBoundingClientRect();
        // 0 when element is well below viewport, 1 at centre, back to 0 above
        const centre = rect.top + rect.height / 2;
        const dist = Math.abs(centre - vh / 2) / vh; // 0..1+ where 0 is centred
        const t = Math.max(0, 1 - dist * 1.4);
        // Scale from 0.78 (off-centre) to 1 (centred)
        const s = 0.78 + t * 0.22;
        el.style.transform = `scale(${s.toFixed(3)})`;
      });
      scalePending = false;
    };
    window.addEventListener('scroll', () => {
      if (!scalePending) {
        scalePending = true;
        requestAnimationFrame(updateScale);
      }
    }, { passive: true });
    updateScale();
  }
</script>
