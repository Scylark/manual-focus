  /* The spacers set the scroll distance the four pledges share. 55vh
     each plus a longer final spacer gives every pledge ~60vh of slot,
     ~40vh of it a static hold, so the whole manifesto takes about 3.4
     screens. It was 220vh/260vh (10 screens, 28% of the page), which
     the October 2026 audit flagged as the page's biggest dead stretch. */
  .manifesto-spacer { height: 55vh; }
  /* Trailing extra spacer that gives the senior operators line
     more time on screen — it's the final read of the manifesto,
     deserves the longest hold. */
  .manifesto-spacer.manifesto-spacer-final { height: 75vh; }
  /* The outer .manifesto-line is just a centering container for the
     absolutely-positioned slot in the sticky stage. The opacity, transform
     and blur are driven directly from scroll position by JS per frame, so
     the line glides smoothly with the scroll rather than transitioning at
     thresholds. No CSS transitions on those properties for that reason. */
  .manifesto-line {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding-inline: var(--space-md);
    pointer-events: none;
    opacity: 0;
    will-change: opacity, transform, filter;
  }
  .manifesto-text {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 9vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
