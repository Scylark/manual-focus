---
import Base from '../layouts/Base.astro';
import SEOHead from '../components/SEOHead.astro';
import BlogCard from '../components/BlogCard.astro';
import FocusObject from '../components/FocusObject.astro';
import { url } from '../utils/paths';
import { readingTime, isListed } from '../utils/blog';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', isListed))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const pageTitle = 'Manual Focus, marketing agency for endurance and sports brands';
const pageDescription = 'Manual Focus is a Sheffield marketing agency for endurance and sports brands. Senior operators do the work, with AI doing the heavy lifting.';

// The hero punchline flips in a character at a time. Each word is wrapped
// so it can never break mid-word; the gap between words keeps its own
// stagger step so the rhythm matches hand-numbered chars.
const heroPunchline = 'with AI doing the heavy lifting.';
let charIndex = 0;
const heroWords = heroPunchline.split(' ').map((word) => {
  const chars = [...word].map((ch) => ({ ch, i: charIndex++ }));
  charIndex++;
  return chars;
});
---
<Base title={pageTitle} description={pageDescription} hideNavUntilScroll>
  <SEOHead slot="seo" type="website" title={pageTitle} description={pageDescription} />

  <!-- The page has one job, which is to introduce Manual Focus as a
       marketing agency. The opening scene does it in one picture. The
       sections after it answer who has used us, whether it works, who
       you'd work with and how to buy. -->

  <!-- THE SCENE. One pinned canvas of dots, driven by scroll. The two
       rings of the mark break into everyone in the sport, out of focus.
       The brand pulls sharp, launch week spikes, then the season fills.
       Each beat carries one kind of work. Without JavaScript or with
       reduced motion the panels stack as plain sections. -->
  <section class="scene" data-scene>
    <div class="scene-stage">
      <canvas class="scene-canvas" aria-hidden="true"></canvas>

      <div class="container scene-inner">
        <div class="scene-panel scene-panel-hero" data-beat="0">
          <div class="hero-inner">
            <div class="hero-eyebrow">
              <span class="dot"></span>
              <span class="mono">MANUAL FOCUS · SHEFFIELD</span>
            </div>

            <h1 class="hero-headline" data-parallax>
              <span class="hero-line hero-line-1">Senior marketing for</span>
              <span class="hero-line hero-line-1">endurance and sports brands</span>
              <span class="hero-line hero-line-2">
                <em class="hero-italic">
                  {heroWords.map((chars) => (
                    <><span class="word">{chars.map(({ ch, i }) => <span class="char" style={`--i: ${i}`}>{ch}</span>)}</span>{' '}</>
                  ))}
                </em>
              </span>
            </h1>

            <div class="hero-meta">
              <p class="hero-sub">
                <span class="lead-full">
                  Manual Focus is a marketing agency in Sheffield for endurance and sports
                  brands. We sharpen your brand and launch your products, then keep the
                  marketing working long after launch week. There are <strong>no account
                  managers or juniors</strong>, so the people on the call are the people doing
                  the work.
                </span>
                <span class="lead-short">
                  A Sheffield marketing agency for endurance and sports brands, with
                  <strong>no account managers or juniors</strong> between you and the work.
                </span>
              </p>
              <div class="hero-ctas">
                <a href={url('/contact/')} class="btn-cta">Book a free working session</a>
                <a href="#ways" class="btn-ghost">How we work together</a>
              </div>
            </div>
          </div>
        </div>

        <div class="scene-panel" data-beat="1">
          <div class="eyebrow">01 · BRAND</div>
          <h2 class="scene-h2">Get the brand in focus</h2>
          <p class="scene-copy">
            Most people in your sport have seen your name without knowing what you stand
            for. We sharpen the position and the message, so the right people know you and
            remember you.
          </p>
          <a href={url('/services/')} class="scene-link">See the brand work</a>
        </div>

        <div class="scene-panel" data-beat="2">
          <div class="eyebrow">02 · LAUNCHES AND CAMPAIGNS</div>
          <h2 class="scene-h2">Launch it so the sport notices</h2>
          <p class="scene-copy">
            We set the launch strategy and run the campaign, with the PR plan your team or
            agency works from. Then comes the part most brands skip, because most campaigns
            stop working when launch week ends.
          </p>
          <a href={url('/services/')} class="scene-link">See the launch work</a>
        </div>

        <div class="scene-panel" data-beat="3">
          <div class="eyebrow">03 · GROWTH</div>
          <h2 class="scene-h2">Keep it working all season</h2>
          <p class="scene-copy">
            We build the website and the email programme that keep selling after the launch.
            AI does the repetitive work, so a small team ships as much as a big one.
          </p>
          <a href="#ways" class="scene-link">See how we work together</a>
        </div>
      </div>

      <div class="scene-scale mono" aria-hidden="true">
        <span class="scene-scale-track"><span class="scene-scale-fill"></span></span>
        <ol>
          <li>The field</li>
          <li>Your brand</li>
          <li>Launch week</li>
          <li>The season</li>
        </ol>
      </div>
      <div class="scene-hint mono" aria-hidden="true">Scroll to pull focus</div>
    </div>
  </section>

  <!-- PROOF — brands first, straight after the hero. Not pinned: it's a
       strip, not a statement. -->
  <section class="section section-alt logos-section">
    <div class="container">
      <div class="eyebrow">001 · IN THE WILD</div>
      <h2 class="reveal logos-headline">We've shipped work with these endurance and sports brands.</h2>
      <div class="logo-bar stagger">
        <span class="brand-mark brand-display">Classified</span>
        <span class="brand-mark brand-serif">Wahoo</span>
        <span class="brand-mark brand-display">Wattbike</span>
        <span class="brand-mark brand-mono">Ribble</span>
        <span class="brand-mark brand-display">RGT</span>
        <span class="brand-mark brand-serif">motif <em>AI</em></span>
        <span class="brand-mark brand-mono">Muuvr</span>
        <span class="brand-mark brand-display">Planet X</span>
        <span class="brand-mark brand-serif">Pelotan</span>
      </div>
      <p class="logos-note reveal">
        Outside endurance, we've run marketing in AI and fintech. We've also worked in hardware and digital assets.
        If you're a B2B company outside sport, read <a href={url('/business/')}>how we work with businesses</a>.
      </p>
    </div>
  </section>

  <!-- RESULTS — the published track record (the same figures as the About
       page). Named client case studies and a client quote slot in here
       once they're cleared to use. -->
  <section class="section section-alt results-section dwell-pin">
    <div class="dwell-pin-stage">
      <div class="container">
        <div class="sec-head">
          <div class="eyebrow">002 · RESULTS</div>
          <div class="ring-slot"><FocusObject size={240} tiltX={50} tiltY={20} spin={-160} scrollSpin={100} enterFrom="right" /></div>
          <h2 class="reveal results-headline">The marketing kept <span class="gradient-text">working</span> after launch.</h2>
        </div>
        <div class="ways-grid stagger">
          <article class="way-card">
            <div class="way-num mono">RGT CYCLING · ACQUISITION</div>
            <p class="result-stat">Acquired</p>
            <h3>by Wahoo Fitness.</h3>
            <p class="way-for">James was on the founding team at RGT Cycling, a virtual cycling platform.</p>
          </article>
          <article class="way-card">
            <div class="way-num mono">BRAND · TURNAROUND</div>
            <p class="result-stat">−65 → +45</p>
            <h3>net promoter score.</h3>
            <p class="way-for">Customers went from mostly unwilling to recommend the brand to recommending it.</p>
          </article>
          <article class="way-card">
            <div class="way-num mono">PR · PRODUCT LAUNCH</div>
            <p class="result-stat">160+</p>
            <h3>media placements from a single launch.</h3>
            <p class="way-for">We plan launches like this one with your team or PR agency.</p>
          </article>
        </div>
        <p class="results-more reveal">
          The track record also includes a conversion rate lifted from 20% to 45%. Prompted
          brand recall went from 0 to 95. The work drove more than 2.2 million sessions to
          one platform. <a href={url('/about/')}>See the full track record</a>
        </p>
      </div>
    </div>
  </section>

  <!-- WHO YOU'LL WORK WITH -->
  <section class="section credibility-section dwell-pin">
    <div class="dwell-pin-stage">
      <FocusObject size={360} tiltX={58} tiltY={-12} spin={180} scrollSpin={60} style="top: 8%; right: 4%;" enterFrom="right" />

      <div class="container">
        <div class="credibility-grid">
          <div class="credibility-copy">
            <div class="eyebrow">003 · WHO YOU'LL WORK WITH</div>
            <h2 class="reveal">
              We've run marketing<br/>
              <span class="gradient-text">from the inside.</span>
            </h2>
            <p class="reveal">
              James Vickers leads Manual Focus. He has spent 15+ years running brand and
              growth in emerging tech, from fintech to sports tech. He was on the founding team
              at RGT Cycling. He works with the Foundry, a collective of senior operators
              with marketing CVs of their own. They share AI tooling so new models reach
              client work soon after they ship.
            </p>
            <a href={url('/about/')} class="btn-ghost reveal">More about James</a>
          </div>
          <picture class="credibility-photo reveal">
            <source
              type="image/webp"
              srcset={`${url('/images/james-vickers-600.webp')} 600w, ${url('/images/james-vickers-900.webp')} 900w`}
              sizes="(min-width: 900px) 440px, 100vw"
            />
            <img
              src={url('/images/james-vickers.jpg')}
              alt="James Vickers leading a line of riders up a gravel road"
              width="1200"
              height="800"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- THREE WAYS TO WORK TOGETHER -->
  <section class="section ways-section" id="ways">
    <FocusObject size={260} tiltX={50} tiltY={15} spin={-130} scrollSpin={-110} style="top: 6%; right: 3%;" enterFrom="right" />

    <!-- Headline gets the dwell-pin treatment so the section's key
         message anchors and holds while the visitor scrolls into the
         cards. -->
    <div class="dwell-pin ways-headline-pin">
      <div class="dwell-pin-stage">
        <div class="container">
          <div class="eyebrow">004 · HOW WE WORK TOGETHER</div>
          <h2 class="big-statement reveal" data-scroll-scale style="transform-origin: left center;">
            Start with the problem<br/>
            you <span class="gradient-text">actually have</span>.
          </h2>
        </div>
      </div>
    </div>

    <!-- Three way-cards, dwell-pinned so they hold while you scroll
         through them -->
    <div class="dwell-pin ways-cards-pin">
      <div class="dwell-pin-stage">
        <FocusObject size={220} tiltX={48} tiltY={-22} spin={170} scrollSpin={-120} style="top: 8%; left: 2%;" enterFrom="left" />
        <div class="container">
          <div class="ways-grid stagger">
            <article class="way-card">
              <div class="way-num mono">/01 · STRATEGIC ADVISOR</div>
              <h3>Your team ships work without anyone steering.</h3>
              <p class="way-for">A senior marketer joins you one or two days a month, so each week's work adds up to a strategy instead of a backlog.</p>
              <p class="way-shape mono">1–2 days a month, on a day rate or monthly retainer</p>
              <a href={`${url('/contact/')}?offer=strategic-advisor`} class="btn-ghost way-cta">Book a free working session</a>
            </article>

            <article class="way-card way-card-featured">
              <div class="way-num mono"><span>/02 · FRACTIONAL CMO</span><span class="way-flag">RECOMMENDED</span></div>
              <h3>You need a part-time CMO.</h3>
              <p class="way-for">A senior marketer joins your leadership team one or two days a week. They set the thesis and run the team. Then they ship the plan, with AI doing the heavy lifting.</p>
              <p class="way-shape mono">1–2 days a week, three-month minimum</p>
              <a href={`${url('/contact/')}?offer=fractional-cmo`} class="btn-cta way-cta">Book a free working session</a>
            </article>

            <article class="way-card">
              <div class="way-num mono">/03 · BUILD &amp; HAND OVER</div>
              <h3>You know what you need built.</h3>
              <p class="way-for">We scope it and build it in weeks, with AI wired in from the start. Then we hand it back with docs and training, so you don't depend on us afterwards.</p>
              <p class="way-shape mono">Project-based, with most builds taking 4–12 weeks</p>
              <a href={`${url('/contact/')}?offer=build-and-hand-over`} class="btn-ghost way-cta">Book a free working session</a>
            </article>
          </div>
        </div>
      </div>
    </div>

    <div class="container">
      <div class="services-cta reveal">
        <p class="services-note">If you'd rather we ran the AI workflows for you, that's <strong>Manual Focus AI</strong>. We plan and produce the content, wireframes included. It arrives in your brand on an agreed schedule, for a monthly retainer.</p>
        <a href={url('/services')} class="btn-ghost">Read the detail</a>
      </div>
    </div>
  </section>

  <!-- FREE, IN THE OPEN — Light Meter (and its free indoor cycling study) and The Lens -->
  <section class="section section-alt open-section dwell-pin">
    <div class="dwell-pin-stage">
      <FocusObject size={320} tiltX={58} tiltY={18} spin={-140} scrollSpin={90} style="top: 6%; right: -4%;" enterFrom="right" />
      <div class="container">
        <div class="eyebrow">005 · FREE, IN THE OPEN</div>
        <h2 class="big-statement reveal" data-scroll-scale style="transform-origin: left center;">
          We work<br/>
          <span class="gradient-text">in the open.</span>
        </h2>
        <div class="ways-grid ways-grid-2 stagger">
          <article class="way-card">
            <div class="way-num mono"><span>/01 · LIGHT METER · AI VISIBILITY</span><span class="way-flag">NEW</span></div>
            <h3>See which brands AI recommends in your category.</h3>
            <p class="way-for">You see which brands six AI engines recommend to your buyers. You also see which sites those engines cite. Our first study, on UK indoor cycling, is free to read.</p>
            <p class="way-shape mono">6 ENGINES · 309 QUESTIONS · 5,562 ANSWERS</p>
            <a href={url('/light-meter/')} class="btn-ghost way-cta">See how Light Meter works</a>
          </article>
          <article class="way-card">
            <div class="way-num mono"><span>/02 · THE LENS · OPEN SOURCE</span><span class="way-flag way-flag-alt">FREE</span></div>
            <h3>Install our AI marketing playbooks free.</h3>
            <p class="way-for">We've published our method as 47 playbooks with 28 skills for Claude. You can read them or install them. We can also run them for you.</p>
            <p class="way-shape mono">47 PLAYBOOKS · 28 SKILLS · MIT LICENSED</p>
            <a href={url('/lens')} class="btn-ghost way-cta">Open The Lens</a>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOG / PERSPECTIVE -->
  <section class="section blog-section dwell-pin">
    <div class="dwell-pin-stage">
      <div class="container">
        <div class="sec-head">
          <div class="eyebrow">006 · PERSPECTIVE</div>
          <div class="ring-slot"><FocusObject size={240} tiltX={56} tiltY={-15} spin={140} scrollSpin={-120} enterFrom="right" /></div>
          <h2 class="reveal">Read what we're learning from the work.</h2>
        </div>
        <div class="blog-grid stagger">
          {posts.map(post => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              slug={post.id}
              minutes={readingTime(post.body ?? '')}
              listenMinutes={post.data.podcast && Math.round(post.data.podcast.duration / 60)}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA CLOSE — with what happens after the click -->
  <section class="section cta-close dwell-pin">
    <div class="dwell-pin-stage">
      <FocusObject size={520} tiltX={60} tiltY={-20} spin={160} scrollSpin={100} style="top: -100px; left: -120px;" enterFrom="left" />
      <FocusObject size={360} tiltX={50} tiltY={25} spin={-130} scrollSpin={-90} style="bottom: -80px; right: -60px;" enterFrom="right" />

      <div class="container cta-close-inner">
        <h2 class="cta-headline reveal">
          Got a problem or a brief?<br/>
          Or a <span class="gradient-text">vague feeling</span> something's off?
        </h2>
        <p class="cta-sub reveal">Bring it and we'll work out the shape of the work together.</p>
        <ol class="cta-steps stagger">
          <li><span class="mono">01</span> We meet for a free 30-minute working session</li>
          <li><span class="mono">02</span> You get a written scope with the cost before anything starts</li>
          <li><span class="mono">03</span> Work starts, with a plan in the first month</li>
        </ol>
        <a href={url('/contact/')} class="btn-cta reveal">Book a free working session</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ============================
     HERO
     ============================ */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding-block: var(--space-xl);
  }

  .hero-inner {
    position: relative;
    z-index: 3;
    display: grid;
    gap: var(--space-sm);
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--color-text-secondary);
  }
  .hero-eyebrow .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-cta-start);
    box-shadow: 0 0 12px var(--color-cta-start);
    animation: pulse 1.6s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.3); }
  }

  .hero-headline {
    font-size: clamp(1.85rem, 4.6vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin-top: var(--space-sm);
    /* Use theme tokens — the hero used to sit over a dark dawn-sky WebGL
       cyclist which justified overriding to cream + text-shadow, but the
       new graphic hero renders on the page bg (cream in light mode, dark
       in dark mode) so theme-driven text colour is correct on both. */
    color: var(--color-text);
  }
  .hero-sub {
    color: var(--color-text-secondary);
    max-width: 540px;
  }
  .hero-eyebrow {
    color: var(--color-text-secondary);
  }
  .hero-scroll-hint .mono {
    color: var(--color-text-muted);
  }

  .hero-line {
    display: block;
    opacity: 0;
    transform: translateY(40px);
    animation: hero-line-in 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hero-line-1 { animation-delay: 0.15s; }
  /* Line 2 fades the container; chars handle their own animation */
  .hero-line-2 {
    animation-delay: 0.25s;
    perspective: 1200px;
    transform-style: preserve-3d;
  }
  .hero-line-3 { animation-delay: 0.45s; }

  @keyframes hero-line-in {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Per-character flip-in for the punchline */
  .char {
    display: inline-block;
    opacity: 0;
    transform: translateY(60px) rotateX(-80deg);
    transform-origin: 50% 100% -10px;
    backface-visibility: hidden;
    animation: char-in 0.85s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(0.7s + var(--i) * 0.055s);
    /* Apply gradient directly to each char — background-clip:text on parent
       doesn't reach through inline-block children */
    font-style: italic;
    background: var(--color-cta-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    /* Extend the padding box past the italic glyph's top-right overhang so the
       gradient covers the full letter instead of clipping at the box edge.
       Negative margin-right keeps letter spacing visually identical. */
    padding-right: 0.18em;
    margin-right: -0.18em;
  }
  @keyframes char-in {
    to { opacity: 1; transform: translateY(0) rotateX(0); }
  }

  /* No gradient here: each .char carries its own. A second
     background-clip:text on this wrapper made Chrome paint a ghost
     shape over the first letter ("E" of "everyone"). */
  .hero-italic {
    font-style: italic;
  }
  /* Wrap each italic word in an inline-block so the per-char inline-blocks
     inside can never break across lines — the whole word wraps as a unit. */
  .hero-italic .word {
    display: inline-block;
    white-space: nowrap;
  }

  .hero-meta {
    margin-top: var(--space-md);
    max-width: 720px;
  }

  .hero-sub {
    font-size: var(--font-size-lg);
    color: var(--color-text);
  }
  .hero-sub strong {
    font-weight: 700;
    background: var(--color-cta-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-sm);
  }

  /* SCROLL hint sits in the bottom-right corner so it never clashes
     with the left-aligned CTAs. Earlier centred placement put it
     between the two buttons, reading as a third sibling CTA. */
  .hero-scroll-hint {
    position: absolute;
    z-index: 3;
    bottom: var(--space-md);
    right: var(--space-md);
    left: auto;
    transform: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    opacity: 0.75;
    pointer-events: none;
  }
  .scroll-arrow {
    width: 1px;
    height: 32px;
    background: linear-gradient(to bottom, var(--color-text-secondary), transparent);
    animation: scrollHint 2s ease-in-out infinite;
  }
  @keyframes scrollHint {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(8px); opacity: 1; }
  }

  /* Short-viewport guard. The hero block (5-line headline + sub +
     CTAs) lives inside a 100svh stage with overflow:hidden. The
     headline is sized off vw, so a short-but-wide window (laptop
     with docked browser, external ultrawide) blows the block past
     the stage edge and clips the CTAs. Below 860px of height the
     headline keys off vh instead, shrinking the whole block to fit. */
  @media (max-height: 860px) {
    .hero-headline {
      font-size: clamp(1.5rem, 5vh, 3.25rem);
    }
    .hero-sub {
      font-size: clamp(0.95rem, 2.3vh, 1.15rem);
    }
    .hero-meta {
      margin-top: var(--space-sm);
    }
  }
  @media (max-height: 700px) {
    .hero-headline {
      font-size: clamp(1.35rem, 4.6vh, 2.6rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line { opacity: 1; transform: none; animation: none; }
    .char { opacity: 1; transform: none; animation: none; }
    .hero-eyebrow .dot,
    .scroll-arrow { animation: none; }
  }

  /* ============================
     PROBLEM
     ============================ */
  .big-statement {
    font-size: clamp(2.5rem, 8vw, 7rem);
    line-height: 0.95;
    max-width: 1100px;
    position: relative;
    z-index: 2;
  }
  .mono { font-family: var(--font-mono); }

  /* ============================
     THE SCENE
     Static by default: the panels stack as ordinary blocks. The script
     adds .is-live, which makes the section tall, pins the stage and lets
     the canvas and the panels follow the scroll.
     ============================ */
  .scene { position: relative; background: var(--color-bg); }
  .scene-stage { position: relative; }
  .scene-canvas { display: none; }
  .scene-inner { position: relative; z-index: 2; padding-block: var(--space-xl); display: grid; gap: var(--space-xl); }
  .scene-scale, .scene-hint { display: none; }
  .lead-short { display: none; }

  .scene-h2 { font-size: clamp(2rem, 4.6vw, 4.25rem); line-height: 0.98; max-width: 14ch; }
  .scene-copy {
    margin-top: var(--space-md);
    font-size: var(--font-size-lg);
    line-height: 1.5;
    color: var(--color-text-secondary);
    max-width: 44ch;
  }
  .scene-link {
    display: inline-block;
    margin-top: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-cta-start);
    text-underline-offset: 0.4em;
  }
  .scene-link::after { content: ' ↓'; }

  .scene.is-live { height: 460vh; }
  .scene.is-live .scene-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }
  .scene.is-live .scene-canvas {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  .scene.is-live .scene-inner { position: absolute; inset: 0; padding-block: 0; display: block; }
  .scene.is-live .scene-panel {
    --base: -50%;
    position: absolute;
    left: var(--space-md);
    top: 50%;
    width: min(46%, 620px);
    opacity: 0;
    pointer-events: none;
    transform: translate3d(0, calc(var(--base) + var(--dy, 0px)), 0);
    will-change: opacity, transform;
  }
  .scene.is-live .scene-panel-hero { width: min(62%, 780px); opacity: 1; pointer-events: auto; }
  /* The headline shares the stage with the mark, so it is sized to keep
     each of its three lines whole beside it, at any window shape. */
  @media (min-width: 768px) {
    .scene .hero-headline { font-size: clamp(1.5rem, min(3.6vw, 5.6vh), 3.5rem); }
  }

  .scene.is-live .scene-scale {
    display: block;
    position: absolute;
    z-index: 3;
    left: var(--space-md);
    right: var(--space-md);
    bottom: 1.5rem;
    max-width: calc(var(--max-width) - 2 * var(--space-md));
    margin-inline: auto;
  }
  .scene-scale-track { display: block; height: 1px; background: var(--color-line); }
  .scene-scale-fill { display: block; height: 1px; width: 0; background: var(--color-cta-gradient); }
  .scene-scale ol {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0.6rem 0 0;
    padding: 0;
  }
  .scene-scale li {
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color 0.3s ease;
  }
  .scene-scale li.is-active { color: var(--color-text); }
  .scene.is-live .scene-hint {
    display: block;
    position: absolute;
    z-index: 3;
    right: var(--space-md);
    bottom: 4.5rem;
    font-size: 0.62rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  /* Phones. Everything is sized to fit the short screen a phone browser
     leaves once its toolbars are showing, so the scene still pins. */
  @media (max-width: 767px) {
    .scene.is-live { height: 420vh; }
    .lead-full { display: none; }
    .lead-short { display: inline; }
    .scene .hero-eyebrow { font-size: 0.62rem; letter-spacing: 0.14em; }
    .scene .hero-headline { font-size: clamp(1.6rem, 7.6vw, 2.6rem); margin-top: 0.25rem; }
    .scene .hero-meta { margin-top: var(--space-sm); }
    .scene .hero-sub { font-size: 1rem; line-height: 1.5; }
    .scene .hero-ctas { flex-direction: column; align-items: flex-start; gap: 0.85rem; margin-top: 1.1rem; }
    .scene .hero-ctas .btn-ghost {
      border: 0;
      padding: 0.25rem 0;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-decoration: underline;
      text-decoration-color: var(--color-cta-start);
      text-underline-offset: 0.4em;
    }
    .scene .eyebrow { font-size: 0.62rem; letter-spacing: 0.14em; margin-bottom: 0.75rem; }
    .scene .eyebrow::before { width: 1.5rem; }
    .scene-h2 { font-size: clamp(1.5rem, 6.8vw, 2.2rem); max-width: none; }
    .scene-copy { font-size: 0.95rem; margin-top: var(--space-sm); }
    .scene-link { margin-top: var(--space-sm); font-size: 0.7rem; }
    .scene.is-live .scene-panel {
      --base: 0%;
      left: 1.25rem;
      right: 1.25rem;
      width: auto;
      top: auto;
      bottom: 4rem;
    }
    .scene.is-live .scene-panel-hero { --base: -50%; top: 50%; bottom: auto; width: auto; }
    .scene.is-live .scene-scale { left: 1.25rem; right: 1.25rem; bottom: 1rem; }
    .scene-scale li { font-size: 0.55rem; letter-spacing: 0.12em; }
    .scene.is-live .scene-hint { display: none; }
  }
  @media (max-width: 767px) and (max-height: 620px) {
    .scene .hero-headline { font-size: 1.5rem; }
    .scene-h2 { font-size: 1.35rem; }
    .scene-copy { font-size: 0.9rem; line-height: 1.45; }
  }
  @media (max-height: 760px) and (min-width: 768px) {
    .scene-h2 { font-size: clamp(1.6rem, 6vh, 3.25rem); }
    .scene-copy { font-size: clamp(0.95rem, 2.5vh, 1.2rem); margin-top: var(--space-sm); }
    .scene-link { margin-top: var(--space-sm); }
  }
  /* Short desktop windows, such as a browser sharing the screen with
     other apps. The hero takes the short lead so the scene still pins. */
  @media (max-height: 640px) and (min-width: 768px), (min-width: 768px) and (max-width: 1024px) and (max-height: 760px) {
    .lead-full { display: none; }
    .lead-short { display: inline; }
    .scene .hero-ctas .btn-cta, .scene .hero-ctas .btn-ghost { padding: 0.8rem 1.5rem; font-size: 0.9rem; }
  }


  /* ============================
     SECTION HEADS WITH A RING SLOT
     The copy sits on the left. The spinning rings get a slot of their
     own on the right, inside the content column, so they line up with
     the cards below and never cross the text. On phones the slot
     shrinks and shares the eyebrow's row.
     ============================ */
  .sec-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "eyebrow ring"
      "h2      ring"
      "copy    ring";
    column-gap: var(--space-md);
    align-items: start;
    position: relative;
    z-index: 2;
  }
  .sec-head > .eyebrow { grid-area: eyebrow; justify-self: start; }
  .sec-head > h2 { grid-area: h2; }
  .sec-head > p { grid-area: copy; }
  .ring-slot {
    grid-area: ring;
    align-self: center;
    position: relative;
    width: clamp(140px, 15vw, 220px);
    aspect-ratio: 1;
  }
  .dwell-pin-stage .ring-slot { width: clamp(110px, 10.5vw, 150px); }
  .ring-slot :global(.focus-object) { inset: 0; width: 100%; transform: translate(0, 30px); }
  /* A slotted ring fades up into place. The component's slide in from
     the side would start it outside a narrow window, where it never
     registers as on screen and so never appears. */
  .ring-slot :global(.focus-object.has-entered) { transform: translate(0, 0); }
  /* The site-wide scroll drift would carry a ring out of its slot, so
     these keep the spin and the scroll rotation only. */
  .ring-slot :global(.focus-object__scroll) { transform: rotateZ(var(--scroll-rot, 0deg)); }
  @media (max-width: 767px) {
    .sec-head {
      grid-template-areas:
        "eyebrow ring"
        "h2      h2"
        "copy    copy";
      column-gap: var(--space-sm);
    }
    .sec-head > .eyebrow { align-self: end; }
    .ring-slot,
    .dwell-pin-stage .ring-slot { width: 84px; align-self: end; margin-bottom: 0.4rem; }
  }

  /* ============================
     THREE WAYS TO WORK TOGETHER
     ============================ */
  /* overflow:visible so the .dwell-pin headline wrapper's sticky
     stage can engage. FocusObjects in this section have small
     offsets so they don't visually extend past the section bounds. */
  .ways-section { overflow: visible; position: relative; }
  .ways-grid {
    margin-top: var(--space-lg);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    z-index: 2;
  }
  .way-card {
    position: relative;
    padding: var(--space-md);
    background: var(--color-bg);
    transition: background 0.3s ease;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .way-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-cta-gradient);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 0;
  }
  /* Hairline gradient accent that draws in on hover from the top edge */
  .way-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 100%;
    height: 2px;
    background: var(--color-cta-gradient);
    transition: right 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 2;
  }
  .way-card:hover::before { opacity: 0.06; }
  .way-card:hover::after { right: 0; }
  .way-card:hover { background: var(--color-bg-alt); }
  .way-card:hover .way-cta { transform: translateX(4px); }
  .way-cta { transition: transform 0.3s ease; }

  /* Featured tier — Fractional CMO */
  .way-card-featured::after { right: 0; }
  .way-flag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--color-cta-start);
    color: var(--color-cta-start);
    border-radius: 999px;
    background: rgba(255, 45, 120, 0.06);
    white-space: nowrap;
    line-height: 1;
  }
  .way-card > * { position: relative; z-index: 1; }
  .way-num {
    font-size: 0.7rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.12em;
    margin-bottom: var(--space-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }
  .way-card h3 {
    font-size: clamp(1.25rem, 1.8vw, 1.75rem);
    margin-bottom: var(--space-xs);
  }
  .way-for {
    color: var(--color-text);
    font-size: var(--font-size-body);
    font-style: italic;
    margin-bottom: var(--space-md);
  }
  .way-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-md);
    flex: 1;
  }
  .way-list li {
    font-size: var(--font-size-body);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xs);
    padding-left: 1rem;
    position: relative;
    line-height: 1.5;
  }
  .way-list li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--color-cta-start);
    font-weight: 700;
  }
  .way-shape {
    color: var(--color-text);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    margin-top: auto;
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--color-line);
  }
  .way-cta {
    margin-top: var(--space-sm);
    align-self: flex-start;
    font-size: 0.75rem;
    padding: 0.5rem 1.1rem;
  }
  .services-cta {
    margin-top: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
    position: relative;
    z-index: 2;
  }
  .services-note {
    font-size: var(--font-size-lg);
    max-width: 760px;
  }

  @media (min-width: 768px) {
    .ways-grid { grid-template-columns: repeat(3, 1fr); }
    .ways-grid.ways-grid-2 { grid-template-columns: repeat(2, 1fr); }
    .services-cta { flex-direction: row; align-items: center; justify-content: space-between; }
  }

  /* ============================
     RESULTS — case cards reuse the way-card grid, with a big
     outcome figure on top and a line of further numbers underneath
     ============================ */
  .results-section { overflow: hidden; position: relative; }
  .results-section .ways-grid { margin-top: var(--space-md); }
  .results-headline {
    font-size: clamp(2rem, 5vw, 4rem);
    position: relative;
    z-index: 2;
    max-width: 1000px;
  }
  .result-stat {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    line-height: 1;
    margin-bottom: var(--space-xs);
    background: var(--color-cta-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .results-more {
    margin-top: var(--space-md);
    max-width: 760px;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body);
    position: relative;
    z-index: 2;
  }
  .results-more a {
    color: var(--color-text);
    white-space: nowrap;
  }

  /* ============================
     LOGOS
     ============================ */
  .logos-section { position: relative; overflow: hidden; }
  .logos-headline {
    font-size: clamp(2rem, 5vw, 4rem);
    position: relative;
    z-index: 2;
    max-width: 1000px;
  }
  .logos-note {
    margin-top: var(--space-lg);
    color: var(--color-text-secondary);
    font-size: var(--font-size-body);
    position: relative;
    z-index: 2;
  }
  .logos-note a { color: var(--color-text); }
  .logo-bar {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-lg);
    align-items: center;
    justify-items: center;
    position: relative;
    z-index: 2;
  }
  .brand-mark {
    color: var(--color-text-secondary);
    transition: color 0.3s ease, transform 0.3s ease;
    cursor: default;
    line-height: 1;
  }
  .brand-mark:hover {
    color: var(--color-text);
    transform: translateY(-2px);
  }
  /* Each brand gets a different typographic treatment so the wall reads as
     a collection of brands rather than a uniform text list. */
  .brand-display {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .brand-serif {
    font-family: 'Inter', serif;
    font-weight: 300;
    font-size: clamp(1.1rem, 1.6vw, 1.5rem);
    letter-spacing: -0.01em;
  }
  .brand-serif em {
    font-style: italic;
    font-weight: 500;
  }
  .brand-mono {
    font-family: var(--font-mono);
    font-size: clamp(0.875rem, 1.2vw, 1.05rem);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 700;
  }
  @media (min-width: 640px) {
    .logo-bar { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 1024px) {
    .logo-bar { grid-template-columns: repeat(5, 1fr); }
  }

  /* ============================
     CREDIBILITY
     ============================ */
  .credibility-section { overflow: hidden; position: relative; }
  .credibility-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    align-items: start;
    position: relative;
    z-index: 2;
  }
  .credibility-copy h2 {
    font-size: clamp(2.5rem, 6vw, 5.5rem);
  }
  .credibility-copy p {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 540px;
    margin-block: var(--space-md);
  }
  .credibility-photo {
    display: block;
    align-self: center;
  }
  .credibility-photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
    border: 1px solid var(--color-line);
  }

  @media (min-width: 900px) {
    .credibility-grid { grid-template-columns: 1.3fr 1fr; }
  }

  /* ============================
     BLOG
     ============================ */
  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    position: relative;
    z-index: 2;
  }
  @media (min-width: 640px) {
    .blog-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .blog-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* ============================
     CTA CLOSE
     ============================ */
  .cta-close {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-2xl);
    text-align: center;
  }
  .cta-close-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    position: relative;
    z-index: 2;
  }
  .cta-headline {
    font-size: clamp(2rem, 6vw, 5rem);
    max-width: 1100px;
    line-height: 1;
  }
  .cta-sub {
    color: var(--color-text-secondary);
    font-size: var(--font-size-lg);
    max-width: 540px;
  }
  .cta-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-xs);
    text-align: left;
  }
  .cta-steps li {
    font-size: var(--font-size-body);
    color: var(--color-text);
  }
  .cta-steps .mono {
    color: var(--color-cta-start);
    margin-right: var(--space-xs);
    letter-spacing: 0.12em;
  }


  /* ============================
     RESPONSIVE TWEAKS — mobile
     ============================ */
  @media (max-width: 768px) {
    /* HERO — tighter spacing, smaller type, hide scroll hint */
    .hero {
      min-height: auto;
      padding-block: var(--space-lg) var(--space-md);
    }
    .hero-headline { font-size: clamp(2.25rem, 11vw, 3.5rem); }
    .hero-sub { font-size: 1rem; line-height: 1.55; }
    .hero-scroll-hint { display: none; }
    .hero-ctas { gap: var(--space-sm); }

    /* Italic char padding — the right-edge crop fix pushes the trailing period
       onto a new line at narrow viewports. Reduce overhang and zero out
       the last char so the line wraps cleanly. */
    .char { padding-right: 0.08em; margin-right: -0.08em; }
    .hero-italic .char:last-child { padding-right: 0; margin-right: 0; }

    /* Kill the scroll-scale animation on mobile — it scales headlines down
       to 78% when off-centre, which looks like a rendering bug on small viewports. */
    [data-scroll-scale] { transform: none !important; }

    /* Section headlines down a notch */
    .big-statement { font-size: clamp(1.875rem, 9vw, 3rem); }
    .logos-headline { font-size: clamp(1.625rem, 7vw, 2.5rem); }
    .cta-headline { font-size: clamp(1.75rem, 8vw, 3rem); }

    /* /02 way-num row — allow MOST CHOSEN pill to wrap below the label
       instead of squashing /02 · FRACTIONAL CMO onto two lines */
    .way-num { flex-wrap: wrap; row-gap: 0.5rem; }

    /* CTA close — less vertical padding */
    .cta-close { padding-block: var(--space-xl); }
    .cta-sub { font-size: 1rem; }

    /* Bigger touch targets on buttons */
    .btn-cta, .btn-ghost { padding: 0.85rem 1.4rem; font-size: 0.85rem; }
    .way-cta { padding: 0.6rem 1.2rem; }
  }

  /* Even tighter on the smallest phones */
  @media (max-width: 380px) {
    .container { padding-inline: var(--space-sm); }
    .hero-headline { font-size: clamp(2rem, 10vw, 3rem); }
  }

  /* ============================
     INTERMEDIATE — tablet portrait/landscape and small laptops
     (769–1024px). Previously the site had a hard cut at 768px:
     below = mobile rules, above = full desktop layout. That left
     iPads and 13" laptops getting desktop type sizes calibrated for
     a 1440+ canvas, which read oversized in the smaller viewport.
     This band tightens type and gutters without flipping to the
     mobile layout (sticky dwell-pin etc. still works in this band).
     ============================ */
  @media (min-width: 769px) and (max-width: 1024px) {
    .hero-headline { font-size: clamp(2.5rem, 6vw, 4rem); }
    .big-statement { font-size: clamp(2.25rem, 6vw, 3.5rem); }
    .logos-headline { font-size: clamp(1.75rem, 4.5vw, 2.5rem); }
    .cta-headline { font-size: clamp(2rem, 5.5vw, 3.25rem); }

    /* Tighter section gutters so content doesn't hug edge-padding
       designed for a 1280+ canvas. */
    .container { padding-inline: var(--space-md); }

    /* Way-cards stay 3-column but with tighter padding so the cards
       don't feel stretched on a narrower viewport. */
    .way-card { padding: var(--space-md); }
  }

  /* ============================
     DWELL-PIN — sections that should hold the visitor's eye briefly
     as they scroll past. Same pattern as the opening scene:
     the section is tall, the content inside is sticky-pinned at the
     top of the viewport for the duration of the pin. Combined with
     the scroll-driven reveal in Base.astro, the visitor sees the
     headline + body fade up into place during the section approach,
     then HOLD in view for ~100vh of pinned scroll before the section
     releases and the next one slides up. The vertical movement
     genuinely pauses for a moment even while the scroll wheel keeps
     spinning. Mobile drops the pin entirely — adds too much page
     length on a phone for too little visual payoff.
     ============================ */
  .section.dwell-pin,
  .dwell-pin {
    /* Section height = stage's natural height + a trailing pad that
       provides the pin range. Using a ::after trailer instead of
       min-height means tall content (like the 3 stacked way-cards
       on mobile) still gets a consistent dwell-pin range — with
       min-height alone, when the stage's content exceeded the
       section min-height, the pin range collapsed to zero. */
    padding-block: 0;
    position: relative;
    background: var(--color-bg);
    overflow: visible;
  }
  .dwell-pin::after {
    content: "";
    display: block;
    /* 50vh on desktop = the dwell-pin pin duration. Half a viewport
       of scroll runway. Long enough for the brain to register a
       pause, short enough that the empty section bg scrolling past
       doesn't read as dead space. Was 100vh (still felt long) and
       220vh originally (definitely too long). */
    height: 50vh;
    background: inherit;
  }
  .dwell-pin-stage {
    position: sticky;
    top: 0;
    /* 100svh stage so it fills the viewport while pinned. Content
       centred inside, so a section with less content has equal
       top/bottom breathing room. Padding tightened from --space-2xl
       to --space-lg so content sits closer to viewport edges during
       the pin — less empty space above/below the headline + body. */
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: var(--space-lg);
    width: 100%;
    background: var(--color-bg);
    /* Clip FocusObjects + other absolutely-positioned decoration
       inside the stage instead of on the section (which would break
       the sticky behaviour). */
    overflow: hidden;
  }
  .dwell-pin-stage > .container { width: 100%; }
  /* Section variants that have their own background colour need to
     pass that through to the dwell-pin sticky stage too, otherwise
     during the exit phase the stage's bg differs from the section's
     and you get a visible colour seam. */
  .section.section-alt.dwell-pin,
  .section.section-alt.dwell-pin .dwell-pin-stage {
    background: var(--color-bg-alt, var(--color-bg));
  }
  /* SHORT LAPTOP SCREENS. A pinned stage has to fit the window, or its
     last lines sit below the fold for the whole hold. Under 820px of
     height the big type keys off the window's height instead of its
     width, with the gaps under it one step tighter. */
  @media (min-width: 1025px) and (max-height: 820px) {
    .dwell-pin-stage { padding-block: var(--space-lg) var(--space-md); }
    .big-statement { font-size: clamp(2.5rem, 10.5vh, 7rem); }
    .open-section .big-statement { font-size: clamp(2.5rem, 9vh, 7rem); }
    .open-section .ways-grid { margin-top: var(--space-md); }
    .results-headline { font-size: clamp(2rem, 7vh, 4rem); }
    .results-more { margin-top: var(--space-sm); }
    .credibility-copy h2 { font-size: clamp(2.5rem, 9vh, 5.5rem); }
    .credibility-copy p { margin-block: var(--space-sm); }
    .blog-section h2 { font-size: clamp(3rem, 10vh, 6rem); }
    .blog-section .blog-grid { margin-top: var(--space-md); }
  }
  /* Shorter still, such as a 768px-high laptop once the browser's own
     bars are taken off. The cards and the closing block tighten a step. */
  @media (min-width: 1025px) and (max-height: 690px) {
    .dwell-pin-stage .way-card { padding: 1.25rem var(--space-md); }
    .dwell-pin-stage .way-num { margin-bottom: var(--space-sm); }
    .cta-close-inner { gap: var(--space-sm); }
    .cta-headline { font-size: clamp(2rem, 9vh, 5rem); }
  }
  /* The same fit for a tablet on its side, where the type is already
     one step smaller. */
  @media (min-width: 769px) and (max-width: 1024px) and (max-height: 820px) {
    .dwell-pin-stage { padding-block: var(--space-lg) var(--space-md); }
    .results-headline { font-size: clamp(1.75rem, 6vh, 2.75rem); }
    .results-more { margin-top: var(--space-sm); }
    .credibility-copy h2 { font-size: clamp(2rem, 7.5vh, 3.5rem); }
    .credibility-copy p { margin-block: var(--space-sm); font-size: var(--font-size-body); }
    .open-section .big-statement { font-size: clamp(2rem, 8vh, 3.5rem); }
    .open-section .ways-grid { margin-top: var(--space-md); }
    .blog-section h2 { font-size: clamp(2.25rem, 8vh, 3.5rem); }
    .blog-section .blog-grid { margin-top: var(--space-md); }
  }

  @media (max-width: 768px) {
    /* ============================
       MOBILE — dwell-pin sticky pattern mirrors desktop using the
       ::after trailer technique. The trailer pads each dwell-pin's
       height by a fixed amount on top of the stage's natural height,
       which is the only way to guarantee a perceptible pin range
       when stage content is taller than the viewport (e.g. the
       ways-cards-pin holds 3 stacked cards = ~2400px on a phone, so
       a static min-height pin range would collapse to zero). With
       the trailer, pin range stays constant at 60–80vh regardless
       of stage height.

       overflow-x:clip on every section catches any 3D-transform
       bleed without becoming a scroll container — sticky inside
       still resolves to the viewport. (hidden would break sticky.)
       ============================ */
    .section {
      overflow-x: clip;
    }
    .section.dwell-pin,
    .dwell-pin {
      padding-block: 0;
    }
    .section.dwell-pin::after {
      height: 80vh;
    }
    .dwell-pin:not(.section)::after {
      height: 60vh;
    }
  }
</style>

<script>
  // Hero parallax — subtle mouse tracking on desktop
  const parallaxEls = document.querySelectorAll<HTMLElement>('[data-parallax]');

  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.addEventListener('mousemove', (e) => {
      const x = (e.clientX / window.innerWidth - 0.5);
      const y = (e.clientY / window.innerHeight - 0.5);
      parallaxEls.forEach(el => {
        el.style.transform = `translate3d(${x * -10}px, ${y * -6}px, 0)`;
      });
    }, { passive: true });
  }

  // The focus scene. One canvas of dots, driven by scroll position.
  //   Beat 0  the mark     the two rings, drawn in dots, beside the headline
  //           the field    the rings break into everyone in the sport
  //   Beat 1  your brand   the people who know you pull sharp into a disc
  //   Beat 2  launch week  the disc becomes twelve weeks, one tall column
  //   Beat 3  the season   the empty weeks fill, left to right
  // Colours come from the theme tokens and follow the light and dark toggle.
  // With reduced motion the script never starts and the panels stay stacked.
  const scene = document.querySelector<HTMLElement>('[data-scene]');
  const sceneCalm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (scene && !sceneCalm) {
    const stage = scene.querySelector<HTMLElement>('.scene-stage')!;
    const inner = scene.querySelector<HTMLElement>('.scene-inner')!;
    const canvas = scene.querySelector<HTMLCanvasElement>('.scene-canvas')!;
    const ctx = canvas.getContext('2d');
    const panels = Array.from(scene.querySelectorAll<HTMLElement>('.scene-panel'));
    const ticks = Array.from(scene.querySelectorAll<HTMLElement>('.scene-scale li'));
    const fill = scene.querySelector<HTMLElement>('.scene-scale-fill');
    const hint = scene.querySelector<HTMLElement>('.scene-hint');

    if (ctx) {
      // The pinned layout only goes live when every panel fits the stage.
      // On a short screen (a small phone, a phone on its side) a panel
      // would be clipped, so the scene stays as plain stacked sections.
      let live = false;
      // On phones the canvas action sits in a band under the nav. The band
      // takes whatever height the tallest beat panel leaves free.
      const SLIM_TOP = 92;
      let slimBottom = SLIM_TOP + 140;
      const fitsStage = () => {
        scene.classList.add('is-live');
        const h = stage.clientHeight;
        let ok: boolean;
        if (stage.clientWidth >= 768) {
          // Centred panels need room for the scale below them.
          ok = panels.every((el) => el.offsetHeight <= h - 112);
        } else {
          const tallest = Math.max(...panels.slice(1).map((el) => el.offsetHeight));
          slimBottom = Math.min(h - 64 - tallest - 38, SLIM_TOP + h * 0.42);
          ok = panels[0].offsetHeight <= h - 96 && slimBottom - SLIM_TOP >= 118;
        }
        scene.classList.toggle('is-live', ok);
        return ok;
      };
      const applyFit = () => {
        const ok = fitsStage();
        if (ok === live) return;
        live = ok;
        if (!live) {
          panels.forEach((el) => {
            el.style.opacity = '';
            el.style.pointerEvents = '';
            el.style.removeProperty('--dy');
          });
        }
      };

      type RGB = [number, number, number];
      type Dot = {
        g: 'A' | 'B' | 'N';
        nx: number; ny: number; depth: number; phase: number; delay: number; u: number; jitter: number;
        idx: number; col: number; slot: number; ringed: boolean; ring: number; ringPos: number;
        noise: RGB; discRGB: RGB; colRGB: RGB;
      };

      // Seeded, so the field looks the same on every visit.
      let seed = 20261111;
      const rnd = () => {
        seed = (seed + 0x6d2b79f5) | 0;
        let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };

      const slim0 = window.innerWidth < 768;
      const GOLDEN = Math.PI * (3 - Math.sqrt(5));
      const CAPTIONS = ['Everyone in your sport', 'The people who know your brand', 'A campaign that stops', 'Marketing that keeps working'];
      // Twelve weeks. Launch week is tall, then the campaign stops.
      const SPIKE = slim0 ? [3, 48, 18, 9, 6, 3, 3, 3, 3, 3, 0, 0] : [8, 96, 36, 20, 12, 8, 4, 4, 4, 4, 0, 0];
      // The same weeks once the marketing keeps working. Each column is a
      // whole number of rows, so the stacks have clean tops.
      const SEASON = slim0 ? [3, 48, 21, 24, 27, 30, 33, 36, 39, 45, 48, 54] : [8, 96, 44, 48, 52, 60, 64, 72, 80, 88, 96, 104];
      const PER_ROW = slim0 ? 3 : 4;
      const MAX_ROWS = Math.max(...SEASON) / PER_ROW;
      const A = SPIKE.reduce((n, c) => n + c, 0);
      const NOISE = slim0 ? 150 : 320;

      const dots: Dot[] = [];
      const base = () => ({
        nx: rnd(), ny: rnd(), depth: 0.25 + rnd() * 0.75, phase: rnd() * Math.PI * 2,
        delay: rnd() * 0.35, u: rnd(), jitter: rnd() - 0.5, ring: -1, ringPos: 0,
        noise: [0, 0, 0] as RGB, discRGB: [0, 0, 0] as RGB, colRGB: [0, 0, 0] as RGB,
      });
      let col = 0;
      let colSlot = 0;
      for (let i = 0; i < A; i++) {
        while (colSlot >= SPIKE[col]) { col++; colSlot = 0; }
        dots.push({ ...base(), g: 'A', idx: i, col, slot: colSlot++, ringed: true });
      }
      let extra = 0;
      for (let c = 0; c < 12; c++) {
        for (let sl = SPIKE[c]; sl < SEASON[c]; sl++) {
          const d: Dot = { ...base(), g: 'B', idx: 0, col: c, slot: sl, ringed: extra % 3 === 0 };
          // The season fills week by week, left to right.
          d.delay = (c / 11) * 0.5 + rnd() * 0.14;
          dots.push(d);
          extra++;
        }
      }
      for (let i = 0; i < NOISE; i++) dots.push({ ...base(), g: 'N', idx: 0, col: 0, slot: 0, ringed: false });
      const ringed = dots.filter((d) => d.ringed);
      const perRing = Math.ceil(ringed.length / 2);
      ringed.forEach((d, i) => { d.ring = i % 2; d.ringPos = Math.floor(i / 2) / perRing; });

      // Theme colours.
      let cA: RGB = [255, 45, 120];
      let cB: RGB = [192, 38, 211];
      let cC: RGB = [0, 229, 255];
      let cMuted: RGB = [134, 129, 122];
      let cText: RGB = [242, 237, 230];
      const hex = (v: string, fallback: RGB): RGB => {
        const m = v.trim().match(/^#([0-9a-f]{6})$/i);
        if (!m) return fallback;
        const n = parseInt(m[1], 16);
        return [n >> 16, (n >> 8) & 255, n & 255];
      };
      const mix = (a: RGB, b: RGB, t: number): RGB => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];
      const grad = (u: number): RGB => (u < 0.5 ? mix(cA, cB, u * 2) : mix(cB, cC, (u - 0.5) * 2));
      const rgba = (c: RGB, a: number) => `rgba(${c[0] | 0},${c[1] | 0},${c[2] | 0},${a.toFixed(3)})`;
      const readColours = () => {
        const cs = getComputedStyle(document.documentElement);
        cA = hex(cs.getPropertyValue('--color-cta-start'), cA);
        cB = hex(cs.getPropertyValue('--color-cta-mid'), cB);
        cC = hex(cs.getPropertyValue('--color-cta-end'), cC);
        cMuted = hex(cs.getPropertyValue('--color-text-muted'), cMuted);
        cText = hex(cs.getPropertyValue('--color-text'), cText);
        for (const d of dots) {
          d.noise = grad(d.u);
          if (d.g === 'A') d.discRGB = grad((d.idx / A) * 0.9 + d.u * 0.1);
          if (d.g !== 'N') d.colRGB = grad((d.col / 11) * 0.9 + d.u * 0.1);
        }
      };
      readColours();
      new MutationObserver(readColours).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

      // Geometry. The action sits right of the copy on wide screens and
      // above it on phones. It is measured from the content column, so the
      // frame lines up with the nav and the scale at every window width.
      let W = 0;
      let H = 0;
      let dpr = 1;
      let narrow = false;
      let ready = false;
      let colL = 0;
      let colR = 0;
      const FRAME_PAD = 22;
      const box = { x0: 0, y0: 0, x1: 0, y1: 0 };
      const resize = () => {
        applyFit();
        const r = stage.getBoundingClientRect();
        W = r.width;
        H = r.height;
        narrow = W < 768;
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        const ir = inner.getBoundingClientRect();
        const gutter = parseFloat(getComputedStyle(inner).paddingLeft) || 0;
        colL = ir.left - r.left + gutter;
        colR = ir.right - r.left - gutter;
        if (narrow) {
          box.x0 = W * 0.09; box.x1 = W * 0.91; box.y0 = SLIM_TOP; box.y1 = slimBottom;
        } else {
          box.x0 = colL + (colR - colL) * 0.56 + FRAME_PAD; box.x1 = colR - FRAME_PAD; box.y0 = H * 0.2; box.y1 = H * 0.78;
        }
        // Sizing a canvas clears it, so repaint straight away.
        if (ready) draw(performance.now());
      };

      const clamp = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
      const seg = (p: number, a: number, b: number) => clamp((p - a) / (b - a));
      const ease = (t: number) => t * t * (3 - 2 * t);
      const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

      let target = 0;
      let smooth = 0;
      let pos = 0;
      const measure = () => {
        const r = scene.getBoundingClientRect();
        const travel = r.height - window.innerHeight;
        target = travel > 0 ? clamp(-r.top / travel) : 0;
      };

      // Keyboard users tab into panels that are faded out. Bring the
      // matching beat on screen when one takes focus.
      const HOLDS = [0, 0.44, 0.69, 0.96];
      panels.forEach((el, i) => {
        el.addEventListener('focusin', () => {
          if (!live || Math.abs(pos - i) < 0.4) return;
          const r = scene.getBoundingClientRect();
          window.scrollTo({ top: window.scrollY + r.top + HOLDS[i] * (r.height - window.innerHeight), behavior: 'instant' as ScrollBehavior });
        });
      });

      const corner = (x: number, y: number, dx: number, dy: number, len: number) => {
        ctx.beginPath();
        ctx.moveTo(x + dx * len, y);
        ctx.lineTo(x, y);
        ctx.lineTo(x, y + dy * len);
        ctx.stroke();
      };

      let running = false;
      let raf = 0;
      let last = 0;
      const frame = (now: number) => {
        if (!running) return;
        raf = requestAnimationFrame(frame);
        draw(now);
      };
      const draw = (now: number) => {
        if (!live) return;
        measure();
        // Ease towards the scroll position by elapsed time, so the motion
        // feels the same at any frame rate.
        const dt = last ? Math.min((now - last) / 1000, 1) : 1;
        last = now;
        smooth += (target - smooth) * (1 - Math.exp(-dt * 9));
        if (Math.abs(target - smooth) < 0.0004) smooth = target;

        const t = now / 1000;
        const a = seg(smooth, 0.06, 0.19);   // the rings break into the field
        const b = seg(smooth, 0.24, 0.38);   // the brand pulls into focus
        const c = seg(smooth, 0.5, 0.64);    // the disc becomes twelve weeks
        const d = seg(smooth, 0.74, 0.9);    // the empty weeks fill
        pos = b + c + d;
        const eb0 = ease(b);
        const ec0 = ease(c);

        // Copy panels cross-fade around their beat.
        panels.forEach((el, i) => {
          const k = pos - i;
          const o = clamp(1 - Math.abs(k) * 2.4);
          el.style.opacity = o.toFixed(3);
          el.style.setProperty('--dy', `${(-k * 44).toFixed(1)}px`);
          el.style.pointerEvents = o > 0.6 ? 'auto' : 'none';
        });
        const active = Math.round(pos);
        ticks.forEach((el, i) => el.classList.toggle('is-active', i === active));
        if (fill) fill.style.width = `${(smooth * 100).toFixed(2)}%`;
        if (hint) hint.style.opacity = clamp(1 - a * 3).toFixed(2);

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, W, H);

        const bw = box.x1 - box.x0;
        const bh = box.y1 - box.y0;
        const bokeh = narrow ? 9 : 15;
        const colSpan = colR - colL;
        // Soft dots sit quieter behind the copy than beside it.
        const quiet = (x: number) => (narrow ? 0.5 : 0.3 + 0.7 * ease(clamp((x - (colL + colSpan * 0.4)) / (colSpan * 0.34))));
        // The mark. Beside the copy on a wide screen, faded behind it on a phone.
        const rcx = narrow ? W / 2 : box.x0 + bw / 2;
        const rcy = narrow ? H * 0.5 : box.y0 + bh / 2;
        const R = narrow ? Math.min(W * 0.3, H * 0.19) : Math.min(bw * 0.3, bh * 0.27);
        const ringAlpha = narrow ? 0.24 : 0.95;
        // Beat 1. A disc packed the way a sunflower packs its seeds.
        const dcx = box.x0 + bw / 2;
        const dcy = box.y0 + bh / 2 + (narrow ? 6 : 0);
        const Rd = Math.min(bw * 0.34, bh * (narrow ? 0.34 : 0.36));
        const turn = t * 0.05;
        // Beats 2 and 3. Twelve columns on one baseline.
        const colW = bw / 12;
        const stackRoom = narrow ? bh - 46 : bh - 80;
        const gap = Math.max(3.6, Math.min(colW / (PER_ROW + 1.1), stackRoom / MAX_ROWS));
        const baseY = box.y1 - (narrow ? 24 : 34);
        const fieldIn = lerp(0.3, 1, ease(a));

        for (const o of dots) {
          const fx = o.nx * W;
          const fy = o.ny * H;
          const drift = 14 * o.depth;
          const wobX = Math.sin(t * 0.25 + o.phase) * drift;
          const wobY = Math.cos(t * 0.21 + o.phase) * drift;
          const soft = 0.07 + o.depth * 0.13;
          let x: number;
          let y: number;
          let radius: number;
          let alpha: number;
          let rgb: RGB;
          // Where the dot starts: on a ring of the mark, or loose in the field.
          const ea = ease(clamp(a * 1.35 - (o.g === 'B' ? o.u * 0.35 : o.delay)));
          let sx = fx;
          let sy = fy;
          if (o.ringed) {
            const ang = o.ringPos * Math.PI * 2 + t * 0.2 * (o.ring ? -1 : 1);
            const rr = R + o.jitter * 6;
            sx = lerp(rcx + Math.cos(ang) * rr, fx, ea);
            sy = lerp(rcy + (o.ring ? R * 0.57 : -R * 0.57) + Math.sin(ang) * rr, fy, ea);
          }
          const ringSharp = o.ringed ? 1 - ea : 0;

          if (o.g === 'N') {
            // The rest of the sport. Stays soft and fades back.
            x = fx + wobX;
            y = fy + wobY;
            radius = 3 + o.depth * bokeh;
            alpha = soft * quiet(x) * fieldIn * (1 - 0.55 * eb0) * (1 - 0.5 * ec0);
            rgb = mix(o.noise, cMuted, eb0);
          } else if (o.g === 'A') {
            const eb = ease(clamp(b * 1.35 - o.delay));
            const ec = ease(clamp(c * 1.35 - o.delay));
            const dr = Math.sqrt((o.idx + 0.5) / A) * Rd;
            const da = o.idx * GOLDEN + turn;
            const bx = dcx + Math.cos(da) * dr;
            const by = dcy + Math.sin(da) * dr;
            const cx = box.x0 + colW * (o.col + 0.5) + ((o.slot % PER_ROW) - (PER_ROW - 1) / 2) * gap;
            const cy = baseY - Math.floor(o.slot / PER_ROW) * gap;
            const held = Math.max(ringSharp, eb);
            x = lerp(lerp(sx, bx, eb), cx, ec) + wobX * (1 - held);
            y = lerp(lerp(sy, by, eb), cy, ec) + wobY * (1 - held);
            const sharp = lerp(narrow ? 2 : 2.7, lerp(Math.min(narrow ? 2.6 : 3.6, Rd * 0.026), Math.min(3, gap * 0.34), ec), eb);
            radius = lerp(3 + o.depth * bokeh, sharp, held);
            alpha = lerp(soft * quiet(x) * fieldIn, lerp(ringAlpha, 0.95, eb), held);
            rgb = mix(mix(o.noise, o.discRGB, eb), o.colRGB, ec);
          } else {
            const ed = ease(clamp(d * 1.7 - o.delay));
            const cx = box.x0 + colW * (o.col + 0.5) + ((o.slot % PER_ROW) - (PER_ROW - 1) / 2) * gap;
            const cy = baseY - Math.floor(o.slot / PER_ROW) * gap;
            const held = Math.max(ringSharp, ed);
            x = lerp(sx, cx, ed) + wobX * (1 - held);
            y = lerp(sy, cy, ed) + wobY * (1 - held);
            radius = lerp(3 + o.depth * bokeh, lerp(narrow ? 2 : 2.7, Math.min(3, gap * 0.34), ed), held);
            const softA = soft * quiet(x) * fieldIn * (1 - 0.55 * eb0 * (1 - ed)) * (1 - 0.5 * ec0 * (1 - ed));
            alpha = lerp(softA, lerp(ringAlpha, 0.95, ed), held);
            rgb = mix(mix(o.noise, cMuted, eb0 * (1 - ed) * (1 - ringSharp)), o.colRGB, ed);
          }

          if (alpha < 0.006) continue;
          ctx.beginPath();
          ctx.arc(x, y, radius, 0, Math.PI * 2);
          ctx.fillStyle = rgba(rgb, alpha);
          ctx.fill();
          if (radius > 6) {
            ctx.lineWidth = 1;
            ctx.strokeStyle = rgba(rgb, Math.min(1, alpha * 1.4));
            ctx.stroke();
          }
        }

        // Viewfinder brackets. They frame the whole stage at first, then
        // close on the action as the focus pulls.
        const eb = ease(b);
        const pad = narrow ? 12 : FRAME_PAD;
        const inset = narrow ? 14 : 28;
        const len = narrow ? 12 : 18;
        const bx0 = lerp(inset, box.x0 - pad, eb);
        const by0 = lerp(inset, box.y0 - pad, eb);
        const bx1 = lerp(W - inset, box.x1 + pad, eb);
        const by1 = lerp(H - inset, box.y1 + pad, eb);
        ctx.lineWidth = 1.5;
        ctx.strokeStyle = rgba(cText, lerp(0.2, 0.5, eb));
        corner(bx0, by0, 1, 1, len);
        corner(bx1, by0, -1, 1, len);
        corner(bx0, by1, 1, -1, len);
        corner(bx1, by1, -1, -1, len);

        // Captions and labels, set in the site's mono face.
        const mono = getComputedStyle(document.documentElement).getPropertyValue('--font-mono') || 'monospace';
        const size = narrow ? 8.5 : 11;
        ctx.font = `500 ${size}px ${mono}`;
        (ctx as CanvasRenderingContext2D & { letterSpacing?: string }).letterSpacing = narrow ? '1px' : '2.2px';
        ctx.textBaseline = 'top';
        ctx.textAlign = 'left';
        CAPTIONS.forEach((label, i) => {
          const o = i === 0 ? ease(seg(a, 0.5, 1)) * clamp(1 - pos * 2.4) : clamp(1 - Math.abs(pos - i) * 2.2);
          if (o <= 0.01) return;
          ctx.fillStyle = rgba(cText, o * 0.78);
          ctx.fillText(label.toUpperCase(), bx0 + len + 6, by0 + 1);
        });

        // A lens focus ring around the disc. It turns as the focus pulls.
        const lb = clamp(1 - Math.abs(pos - 1) * 2.2);
        if (lb > 0.01) {
          const fr = Rd + (narrow ? 10 : 20);
          ctx.lineWidth = 1;
          ctx.strokeStyle = rgba(cText, lb * 0.22);
          ctx.beginPath();
          ctx.arc(dcx, dcy, fr, 0, Math.PI * 2);
          ctx.stroke();
          const spin = smooth * 9;
          for (let k = 0; k < 72; k++) {
            const ang = (k / 72) * Math.PI * 2 + spin;
            const long = k % 6 === 0;
            const r1 = fr + 4;
            const r2 = fr + (long ? (narrow ? 9 : 12) : narrow ? 6 : 7);
            ctx.strokeStyle = long ? rgba(cC, lb * 0.8) : rgba(cText, lb * 0.3);
            ctx.beginPath();
            ctx.moveTo(dcx + Math.cos(ang) * r1, dcy + Math.sin(ang) * r1);
            ctx.lineTo(dcx + Math.cos(ang) * r2, dcy + Math.sin(ang) * r2);
            ctx.stroke();
          }
        }

        // The week axis under the columns.
        const lo = pos >= 2 ? 1 : clamp(1 - (2 - pos) * 2.2);
        if (lo > 0.01) {
          ctx.strokeStyle = rgba(cText, lo * 0.18);
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(box.x0, baseY + gap);
          ctx.lineTo(box.x1, baseY + gap);
          ctx.stroke();
          ctx.textBaseline = 'top';
          ctx.textAlign = narrow ? 'left' : 'center';
          ctx.fillStyle = rgba(cA, lo);
          ctx.fillText('LAUNCH WEEK', narrow ? box.x0 : box.x0 + colW * 1.5, baseY + gap + (narrow ? 7 : 10));
          ctx.textAlign = 'right';
          ctx.fillStyle = rgba(cText, lo * 0.6);
          ctx.fillText('WEEK 12', box.x1, baseY + gap + (narrow ? 7 : 10));
        }
      };

      resize();
      new ResizeObserver(resize).observe(stage);
      ready = true;
      draw(performance.now());
      const start = () => { if (!running) { running = true; last = 0; raf = requestAnimationFrame(frame); } };
      const stop = () => { running = false; cancelAnimationFrame(raf); };
      new IntersectionObserver((entries) => {
        entries.forEach((e) => (e.isIntersecting && !document.hidden ? start() : stop()));
      }, { rootMargin: '10% 0px 10% 0px' }).observe(scene);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else if (scene.getBoundingClientRect().bottom > 0 && scene.getBoundingClientRect().top < window.innerHeight) start();
      });
    }
  }

  // Scroll-scale headlines — grow as they approach centre of viewport
  const scaleEls = document.querySelectorAll<HTMLElement>('[data-scroll-scale]');
  if (scaleEls.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let scalePending = false;
    const updateScale = () => {
      const vh = window.innerHeight;
      scaleEls.forEach(el => {
        const rect = el.getBoundingClientRect();
        // 0 when element is well below viewport, 1 at centre, back to 0 above
        const centre = rect.top + rect.height / 2;
        const dist = Math.abs(centre - vh / 2) / vh; // 0..1+ where 0 is centred
        const t = Math.max(0, 1 - dist * 1.4);
        // Scale from 0.78 (off-centre) to 1 (centred)
        const s = 0.78 + t * 0.22;
        el.style.transform = `scale(${s.toFixed(3)})`;
      });
      scalePending = false;
    };
    window.addEventListener('scroll', () => {
      if (!scalePending) {
        scalePending = true;
        requestAnimationFrame(updateScale);
      }
    }, { passive: true });
    updateScale();
  }
</script>
