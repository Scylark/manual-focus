---
// Landing page for B2B and corporate companies. One idea carries it: the
// agency is called Manual Focus, so the page pulls focus. The opening scene
// is a pinned canvas of out-of-focus dots (every company that could buy).
// Scrolling sharpens the ones that fit, stacks them into a pipeline, then
// sets them running as two rings, the Manual Focus mark. Each beat introduces
// one strand of the work. The detail sections below reuse the site's cards,
// tables and diagram figures. Colours and fonts come from the theme tokens.
import Base from '../layouts/Base.astro';
import SEOHead from '../components/SEOHead.astro';
import FocusObject from '../components/FocusObject.astro';
import { url } from '../utils/paths';
import '../styles/diagrams.css';

const title = 'Sales and marketing for B2B and corporate companies';
const description = 'Manual Focus brings senior sales and marketing leadership to B2B and corporate companies, with AI built into prospecting and business process.';
const contact = (offer = '') => (offer ? `${url('/contact/')}?offer=${offer}` : url('/contact/'));

const record = [
  { value: '£150M+', label: 'in assets under management, in a qualified B2B pipeline James built from cold outreach' },
  { value: 'Millions', word: true, label: 'in partnership revenue, from high-profile fintech partnerships James negotiated and closed' },
  { value: '$400M', label: 'digital asset project, with James leading the marketing' },
  { value: 'Acquired', word: true, label: 'the technology company James co-founded, bought by global fitness brand Wahoo' },
  { value: '1.5M+', label: 'end users behind the financial institutions that signed letters of intent in a pipeline James ran' },
  { value: '109M', label: 'potential audience for one product launch, picked up by 119 outlets including the Associated Press' },
  { value: '100+', label: 'brand partnerships behind a single growth model' },
  { prefix: '−65 →', value: '+45', label: 'net promoter score, in a brand turnaround' },
  { value: '$4.5M', label: 'funding round, supported by the go-to-market James built' },
];

// One example per strand. Every figure comes from James's own record.
const cases = [
  {
    tag: '01 · B2B PROSPECTING',
    name: 'Motif',
    title: 'A B2B pipeline for an AI wealth advisory.',
    body: 'Motif is a Swiss AI wealth advisory backed by Liminal, the venture group founded by Temasek. James runs its marketing and its B2B pipeline as fractional CMO. He took the company into B2B outreach with AI supporting the work, then launched its Clarity system on the wire to 119 outlets, the Associated Press among them.',
    stats: [
      { n: '1,000+', l: 'fintech organisations contacted' },
      { n: '£150M+', l: 'in assets under management under negotiation' },
      { n: '1.5M+', l: 'end users behind signed letters of intent' },
      { n: '109M', l: 'potential audience for the launch' },
    ],
    href: '#prospecting',
    link: 'How the prospecting works',
  },
  {
    tag: '02 · SALES AND MARKETING LEADERSHIP',
    name: 'Haven',
    title: 'Marketing leadership for a $400M digital asset project.',
    body: 'Haven is a privacy-focused digital asset project worth $400M. James led its marketing, in a category where buyers need the product explained before they will trust it.',
    stats: [
      { n: '$400M', l: 'project value' },
    ],
    href: '#leadership',
    link: 'How we lead the function',
  },
  {
    tag: '03 · AI FOR EXECUTIVES AND BUSINESS PROCESS',
    name: 'Pyramid',
    title: 'A company-wide AI assistant on live data.',
    body: "Pyramid is a global motorcycle retailer with more than 25,000 products. Its staff ask the Oracle, a company-wide AI assistant, a question in their internal messaging app. It answers from live store and ERP data. Pyramid's own developer built much of it and owns the repository, so nothing depends on us.",
    stats: [
      { n: '1 day', l: 'from nothing to answering real questions' },
      { n: '6', l: 'data sources loading every night' },
      { n: '5', l: 'live dashboards' },
      { n: '41', l: 'automated test files behind its rules' },
    ],
    href: '#executives',
    link: 'How the AI programmes run',
  },
];
---
<Base title={title} description={description} hideNavUntilScroll>
  <SEOHead slot="seo" type="service" title={title} description={description} breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'For business', url: '/business/' }]} />

  <!-- THE SCENE. Hero plus the three strands, on one pinned stage. Without
       JavaScript or with reduced motion the panels stack as plain sections. -->
  <section class="scene" data-scene>
    <div class="scene-stage">
      <canvas class="scene-canvas" aria-hidden="true"></canvas>

      <div class="container scene-inner">
        <div class="scene-panel scene-panel-hero" data-beat="0">
          <div class="eyebrow">MANUAL FOCUS · SHEFFIELD · B2B</div>
          <h1 class="scene-headline">
            Senior sales and marketing<br/>
            for B2B companies<br/>
            <em class="gradient-text">with AI doing the heavy lifting.</em>
          </h1>
          <p class="scene-lead">
            Manual Focus is a senior sales and marketing team led by James Vickers. He has
            built multi-million dollar sales pipelines and closed high-profile fintech
            partnerships worth millions in revenue. The technology company he co-founded was
            bought by a global brand. We bring that record to your company, with AI doing the
            research and the process work.
          </p>
          <div class="scene-ctas">
            <a href={contact()} class="btn-cta">Book a free working session</a>
            <a href="#record" class="btn-ghost">See the track record</a>
          </div>
        </div>

        <div class="scene-panel" data-beat="1">
          <div class="eyebrow">01 · B2B PROSPECTING</div>
          <h2 class="scene-h2">Finding the accounts that fit</h2>
          <p class="scene-copy">
            Your market is every company that could buy from you. AI researches each one
            against your ideal customer profile, so your sales team only contacts the
            accounts with a reason to act now.
          </p>
          <a href="#prospecting" class="scene-link">How the prospecting works</a>
        </div>

        <div class="scene-panel" data-beat="2">
          <div class="eyebrow">02 · SALES AND MARKETING LEADERSHIP</div>
          <h2 class="scene-h2">Turning the shortlist into signed deals</h2>
          <p class="scene-copy">
            A shortlist becomes pipeline when sales and marketing say the same thing. We
            write the one message house both teams use, then run the outreach and the
            partnership conversations against it.
          </p>
          <a href="#leadership" class="scene-link">How we lead the function</a>
        </div>

        <div class="scene-panel" data-beat="3">
          <div class="eyebrow">03 · AI FOR EXECUTIVES AND BUSINESS PROCESS</div>
          <h2 class="scene-h2">Running the process every week</h2>
          <p class="scene-copy">
            The pipeline keeps moving when nobody has to remember to update it. We put AI
            into the reporting and the follow-up, with the governance written in code, so
            your executives get answers from live data.
          </p>
          <a href="#executives" class="scene-link">How the AI programmes run</a>
        </div>
      </div>

      <div class="scene-scale mono" aria-hidden="true">
        <span class="scene-scale-track"><span class="scene-scale-fill"></span></span>
        <ol>
          <li>Noise</li>
          <li>Shortlist</li>
          <li>Pipeline</li>
          <li>Loop</li>
        </ol>
      </div>
      <div class="scene-hint mono" aria-hidden="true">Scroll to pull focus</div>
    </div>
  </section>

  <!-- TRACK RECORD -->
  <section class="section section-alt biz-record" id="record-section">
    <FocusObject size={300} tiltX={58} tiltY={18} spin={-140} scrollSpin={90} style="top: 4%; right: -3%;" enterFrom="right" />
    <div class="container">
      <div class="eyebrow">TRACK RECORD</div>
      <h2 id="record" class="biz-h2 reveal">Track record</h2>
      <p class="biz-copy reveal">
        James Vickers has spent 15+ years leading sales and marketing inside technology
        companies, most recently in AI and fintech. He is a member of the Chartered Institute
        of Marketing and of the Chartered Institute of Public Relations. He built these
        pipelines himself, which is who you get on the call.
      </p>
      <div class="numbers-grid stagger">
        {record.map((r) => (
          <div class="number-card">
            <div class="number-value">
              {r.prefix && <span class="num-prefix">{r.prefix}</span>}
              <span class:list={['num-main', { 'num-word': r.word }]}>{r.value}</span>
            </div>
            <div class="number-label">{r.label}</div>
          </div>
        ))}
      </div>
      <p class="biz-note reveal">
        James now advises companies that use AI to manage people's wealth, while Manual Focus
        runs an AI efficiency programme for a global motorcycle retailer. <a href={url('/about/')}>See the full track record</a>
      </p>
    </div>
  </section>

  <!-- EXAMPLES -->
  <section class="section biz-cases" id="examples-section">
    <div class="container">
      <div class="eyebrow">EXAMPLES</div>
      <h2 id="examples" class="biz-h2 reveal">Three examples of the work</h2>
      <div class="ways-grid stagger">
        {cases.map((c) => (
          <article class="way-card case-card">
            <div class="way-num mono">{c.tag}</div>
            <p class="case-name">{c.name}</p>
            <h3>{c.title}</h3>
            <p class="case-body">{c.body}</p>
            <dl class="case-stats">
              {c.stats.map((st) => (
                <div>
                  <dt>{st.n}</dt>
                  <dd>{st.l}</dd>
                </div>
              ))}
            </dl>
            <a href={c.href} class="scene-link case-link">{c.link}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- STRAND 1 · B2B PROSPECTING -->
  <section class="section biz-strand" id="prospecting-section">
    <FocusObject size={260} tiltX={50} tiltY={15} spin={-130} scrollSpin={-110} style="top: 4%; right: 2%;" enterFrom="right" />
    <div class="container">
      <div class="eyebrow">01 · B2B PROSPECTING</div>
      <h2 id="prospecting" class="biz-h2 reveal">B2B prospecting with AI research in the loop</h2>
      <p class="biz-copy reveal">
        Outbound stopped working when every company could send ten thousand emails. It works
        again when the research that used to be too slow gets done for every account, so
        fewer, better-chosen people hear a message that fits them. We build that pipeline on
        Apollo and Claude, then hand it to your sales team with the approvals built in.
      </p>

      <div class="post-content biz-figure reveal">
        <figure class="dg dg-chain"><div class="dg-head"><span class="dg-kicker">B2B prospecting · the workflow</span><span class="dg-title">From the profile to the pipeline</span></div><ol class="dg-list dg-steps"><li class="dg-step dg-card"><span class="dg-num">1</span><span><span class="dg-strong">Ideal customer profile</span><span class="dg-q">Who exactly are we for?</span><span class="dg-chip">Strategy · people</span></span></li><li class="dg-step dg-card"><span class="dg-num">2</span><span><span class="dg-strong">The wide list</span><span class="dg-q">Every company that could fit</span><span class="dg-chip">Apollo</span></span></li><li class="dg-step dg-card"><span class="dg-num">3</span><span><span class="dg-strong">AI research</span><span class="dg-q">What does each account show?</span><span class="dg-chip">Claude</span></span></li><li class="dg-step dg-card"><span class="dg-num">4</span><span><span class="dg-strong">The shortlist</span><span class="dg-q">Who fits best right now?</span><span class="dg-chip">Claude · people approve</span></span></li><li class="dg-step dg-card"><span class="dg-num">5</span><span><span class="dg-strong">Messages per segment</span><span class="dg-q">Which message leads?</span><span class="dg-chip">Claude · people approve</span></span></li><li class="dg-step dg-card dg-go"><span class="dg-num">6</span><span><span class="dg-strong">Landing pages</span><span class="dg-q">Where does the click land?</span><span class="dg-chip">Claude Code · GitHub</span></span></li><li class="dg-step dg-card dg-go"><span class="dg-num">7</span><span><span class="dg-strong">Sequences</span><span class="dg-q">Who hears what, when?</span><span class="dg-chip">Apollo</span></span></li><li class="dg-step dg-card dg-go"><span class="dg-num">8</span><span><span class="dg-strong">Measure and learn</span><span class="dg-q">Which segment replied?</span><span class="dg-chip">Control</span></span></li></ol><div class="dg-note">Step 1 is strategy and stays with people. Steps 2 to 7 run on AI and software with a person approving every send. Step 8 feeds the next round.</div></figure>
      </div>

      <div class="ways-grid stagger">
        <article class="way-card">
          <div class="way-num mono">/01 · MEETING PREP STACK</div>
          <h3>A context pack before every sales meeting.</h3>
          <p class="way-for">The pack is built from the CRM history and the inbox, with the attendees' recent posts, so the rep walks in informed after ten minutes of work instead of forty.</p>
          <p class="way-shape mono">Playbook · ships in 1 working day</p>
          <a href={url('/lens/productivity/meeting-prep-stack/')} class="btn-ghost way-cta">Read the playbook</a>
        </article>
        <article class="way-card">
          <div class="way-num mono">/02 · CALL FOLLOW-UP LOOP</div>
          <h3>The call becomes the CRM update.</h3>
          <p class="way-for">After the call, the transcript becomes the CRM update and a follow-up email in your voice, with the tasks logged the same afternoon.</p>
          <p class="way-shape mono">Playbook · ships in 1 working day</p>
          <a href={url('/lens/productivity/call-follow-up-loop/')} class="btn-ghost way-cta">Read the playbook</a>
        </article>
        <article class="way-card">
          <div class="way-num mono">/03 · WEEKLY PIPELINE ROLLUP</div>
          <h3>CRM data into a status the board can read.</h3>
          <p class="way-for">The rollup takes twenty minutes from the CRM export to a delivered status, with the narrative written for the people who read it. It works with HubSpot or Salesforce.</p>
          <p class="way-shape mono">Playbook · ships in 1 working day</p>
          <a href={url('/lens/productivity/weekly-pipeline-rollup/')} class="btn-ghost way-cta">Read the playbook</a>
        </article>
      </div>

      <p class="biz-note reveal">
        The ideal customer profile stays with people. So does the approval before every send,
        because a named work address is still personal data under UK GDPR. The full method,
        with the UK rules on B2B email, is in the
        <a href={url('/blog/go-to-market-automation-claude-apollo-basics/')}>go-to-market automation guide</a>.
      </p>
    </div>
  </section>

  <!-- STRAND 2 · SALES AND MARKETING LEADERSHIP -->
  <section class="section section-alt biz-strand" id="leadership-section">
    <FocusObject size={280} tiltX={50} tiltY={20} spin={-160} scrollSpin={100} style="top: 6%; right: 3%;" enterFrom="right" />
    <div class="container">
      <div class="eyebrow">02 · SALES AND MARKETING LEADERSHIP</div>
      <h2 id="leadership" class="biz-h2 reveal">Corporate sales and marketing leadership</h2>
      <p class="biz-copy reveal">
        James has led sales and marketing from inside the company rather than from an agency
        desk. In fintech he negotiated and closed high-profile partnerships himself, which is
        why the message house below gets written for the room as well as the website. In
        every category the work starts with one position that sales and marketing both use.
        Demand and lifecycle then run against it.
      </p>

      <div class="post-content biz-figure reveal">
        <figure class="dg dg-hier"><div class="dg-head"><span class="dg-kicker">Corporate sales and marketing · the message house</span><span class="dg-title">One claim, three supporting messages</span></div><div class="dg-split"><div><div class="dg-core"><span class="dg-label">Core claim</span><span class="dg-strong">The one sentence your sales deck and your website both make</span></div><ul class="dg-list dg-support"><li><span class="dg-sup"><span class="dg-label">Supporting</span><span class="dg-strong">What changes for the buyer</span></span><span class="dg-proof"><span class="dg-label">Proof</span>A measured result</span></li><li><span class="dg-sup"><span class="dg-label">Supporting</span><span class="dg-strong">Why act now</span></span><span class="dg-proof"><span class="dg-label">Proof</span>A dated trigger</span></li><li><span class="dg-sup"><span class="dg-label">Supporting</span><span class="dg-strong">Why choose you</span></span><span class="dg-proof"><span class="dg-label">Proof</span>A reference customer</span></li></ul></div><div><span class="dg-label">How far each channel goes</span><ul class="dg-list dg-bars"><li><span class="dg-bar-name">Cold email</span><span class="dg-bar" style="--f:35%"></span><span class="dg-q">One supporting message, chosen by segment</span></li><li><span class="dg-bar-name">Sales deck</span><span class="dg-bar" style="--f:70%"></span><span class="dg-q">The core claim with its proof</span></li><li><span class="dg-bar-name">Website</span><span class="dg-bar" style="--f:100%"></span><span class="dg-q">The whole house</span></li></ul></div></div><div class="dg-note">Outreach takes the supporting message its segment points to. The website carries the whole house. Both get checked against the same document before they ship.</div></figure>
      </div>

      <div class="ways-grid stagger">
        <article class="way-card">
          <div class="way-num mono">/01 · POSITIONING AUDIT</div>
          <h3>What you say against what you show.</h3>
          <p class="way-for">We run your public surface through a six-pass audit and rank the contradictions by severity. You get a sharpened positioning brief in a working day.</p>
          <p class="way-shape mono">Playbook · ships in 1 working day</p>
          <a href={url('/lens/brand/positioning-audit-pipeline/')} class="btn-ghost way-cta">Read the playbook</a>
        </article>
        <article class="way-card way-card-featured">
          <div class="way-num mono"><span>/02 · MESSAGE HOUSE</span><span class="way-flag">START HERE</span></div>
          <h3>One document sales and marketing both use.</h3>
          <p class="way-for">We turn a positioning brief into a four-tier message house in a day, with a rebuttal sheet for the twelve hardest pushbacks your sales team hears.</p>
          <p class="way-shape mono">Playbook · ships in 1 working day</p>
          <a href={url('/lens/brand/message-house-generator/')} class="btn-cta way-cta">Read the playbook</a>
        </article>
        <article class="way-card">
          <div class="way-num mono">/03 · LIFECYCLE JOURNEY</div>
          <h3>Every touchpoint drafted in your voice.</h3>
          <p class="way-for">We map a multi-segment lifecycle journey and route it by behaviour signal. It ships in a working week, in place of three weeks of agency work.</p>
          <p class="way-shape mono">Playbook · ships in 1 working week</p>
          <a href={url('/lens/demand/lifecycle-journey-builder/')} class="btn-ghost way-cta">Read the playbook</a>
        </article>
      </div>

      <p class="biz-note reveal">
        As a fractional CMO we set the marketing thesis and a 90-day plan in the first month,
        then lead the team you have one or two days a week, with reporting to the CEO and
        board. You can see the message house method worked through on our own product in
        <a href={url('/blog/wattplan-messaging-hierarchy/')}>the WattPlan messaging house</a>.
        The research behind it is in the
        <a href={url('/lens/demand/category-entry-points/')}>category entry point playbook</a>.
      </p>
    </div>
  </section>

  <!-- STRAND 3 · AI FOR EXECUTIVES AND BUSINESS PROCESS -->
  <section class="section biz-strand" id="executives-section">
    <FocusObject size={300} tiltX={58} tiltY={-12} spin={180} scrollSpin={60} style="top: 6%; left: -4%;" enterFrom="left" />
    <div class="container">
      <div class="eyebrow">03 · AI FOR EXECUTIVES AND BUSINESS PROCESS</div>
      <h2 id="executives" class="biz-h2 reveal">AI for executives and business process</h2>
      <p class="biz-copy reveal">
        Manual Focus runs AI efficiency programmes, including one for a global motorcycle
        retailer. The work is phased and priced
        with a decision gate between phases, so you can stop at any point and keep everything
        built so far. We start with the questions executives ask every week,
        then build the process that answers them.
      </p>

      <div class="post-content biz-figure reveal">
        <figure class="dg dg-trace-fig"><div class="dg-head"><span class="dg-kicker">AI for executives · how a programme runs</span><span class="dg-title">From the question to the process</span></div><div class="dg-trace"><div class="dg-trace-head"><span class="dg-label">The question an exec asks</span><span class="dg-label">The process underneath</span><span class="dg-label">What we install</span></div><div class="dg-trace-row"><span class="dg-cell dg-t1"><span class="dg-label">The question</span>What sold this week, by channel?</span><span class="dg-cell dg-t2"><span class="dg-label">The process</span>A weekly report assembled by hand from three systems</span><span class="dg-cell dg-t3"><span class="dg-label">What we install</span>An assistant in your internal messaging app that answers from the live data, read only</span></div><div class="dg-trace-row"><span class="dg-cell dg-t1"><span class="dg-label">The question</span>Where did last quarter go?</span><span class="dg-cell dg-t2"><span class="dg-label">The process</span>Five status reports in five formats</span><span class="dg-cell dg-t3"><span class="dg-label">What we install</span>A quarterly synthesis the board reads, in two hours instead of two days</span></div><div class="dg-trace-row"><span class="dg-cell dg-t1"><span class="dg-label">The question</span>Can we trust what the AI says?</span><span class="dg-cell dg-t2"><span class="dg-label">The process</span>Nobody owns the rules</span><span class="dg-cell dg-t3"><span class="dg-label">What we install</span>Governance in code. Read-only access, with no AI approving its own change</span></div><div class="dg-trace-row"><span class="dg-cell dg-t1"><span class="dg-label">The question</span>Which process do we automate first?</span><span class="dg-cell dg-t2"><span class="dg-label">The process</span>Whichever vendor demoed last</span><span class="dg-cell dg-t3"><span class="dg-label">What we install</span>A 90-day plan that rebuilds two workflows, measured weekly</span></div></div><div class="dg-note">Every row starts from a question an executive already asks, which is where the first phase of a programme begins.</div></figure>
      </div>

      <div class="biz-grid biz-grid-wide">
        <div class="reveal">
          <h3 class="biz-h3">Governance written in code</h3>
          <p class="biz-body">
            The Oracle at Pyramid can only read. Its calls to the ERP are limited to read-only
            methods, while the code rejects any store credential whose scope goes beyond
            read. Tests prove a write gets refused before any request is sent. It stores
            aggregates rather than customer records. Whatever it retrieves counts as
            evidence, never as instruction. No AI assistant can approve or merge its own
            change, because Pyramid's own developer owns the repository.
          </p>
        </div>
        <div class="reveal">
          <h3 class="biz-h3">Briefings for the leadership team</h3>
          <p class="biz-body">
            A new model ships most weeks. We brief leadership teams on which tools matter this
            quarter, mapped to the processes you already run. The brief ends with the two
            workflows worth rebuilding first and the one to leave alone. Start with the
            <a href={url('/blog/the-90-day-ai-integration-plan/')}>90-day AI integration plan</a>
            and <a href={url('/blog/evaluating-ai-tools-without-falling-for-the-demo/')}>how to evaluate AI tools without falling for the demo</a>.
          </p>
        </div>
      </div>

      <h3 class="biz-h3 biz-table-title reveal">Where AI goes in the business</h3>
      <div class="biz-table-wrap reveal">
        <table class="biz-table">
          <thead>
            <tr><th>The work</th><th>Who does it</th><th>Why</th></tr>
          </thead>
          <tbody>
            <tr><td>Research on an account or a market</td><td>AI, with a link to every source</td><td>It used to be too slow to do for every account</td></tr>
            <tr><td>First drafts of proposals and board papers</td><td>AI in your voice, a person approves</td><td>The voice is checkable but the facts need a person</td></tr>
            <tr><td>The position and the core claim</td><td>People</td><td>AI writes a plausible position for anyone, which is the problem</td></tr>
            <tr><td>Pricing and the trust pages</td><td>People</td><td>Read <a href={url('/blog/when-not-to-use-ai-in-marketing/')}>when not to use AI in marketing</a></td></tr>
            <tr><td>Anything that spends money or reaches a customer</td><td>A person approves each one</td><td>The approval is the control, so it stays visible</td></tr>
            <tr><td>The rules for what AI can read</td><td>Written in code, with tests</td><td>Rules in a PDF drift, so we write them in code where a broken one fails loudly</td></tr>
          </tbody>
        </table>
      </div>

      <ul class="biz-links stagger">
        <li><a href={url('/lens/productivity/quarterly-okr-synthesis/')}>Quarterly OKR synthesis</a>, five team reports into a board narrative</li>
        <li><a href={url('/lens/productivity/document-drafting-partner/')}>Document drafting partner</a>, outline to a board paper in your voice</li>
        <li><a href={url('/lens/ops/evaluation-frameworks/')}>Evaluation frameworks</a>, how to score AI output before a person sees it</li>
        <li><a href={url('/lens/ops/brand-guardrails-as-code/')}>Brand guardrails as code</a>, the check that runs before anything ships</li>
        <li><a href={url('/blog/the-hidden-cost-of-ai-adoption/')}>The hidden cost of AI adoption</a>, why rollouts stall on people rather than tools</li>
      </ul>
    </div>
