  // Starter diagnostic. Two questions, hardcoded decision tree,
  // mirrors the branching the setup-the-lens skill runs during
  // onboarding. Self-contained — additive only.
  type Result = { title: string; why: string; meta: string; url: string };
  type Q2 = { q: string; options: { label: string; result: Result }[] };

  const TREE: Record<string, { label: string; q2: Q2 }> = {
    brand: {
      label: 'Brand work, like positioning or naming',
      q2: {
        q: 'Which of these sounds most like it?',
        options: [
          {
            label: "I've inherited a brand and need an honest read",
            result: {
              title: 'Positioning audit pipeline',
              why: 'It runs a six-pass audit of where the brand sits today, using its real public surface. Everything else in the brand stack builds on it.',
              meta: '1 WORKING DAY · BRAND STACK',
              url: '/lens/brand/positioning-audit-pipeline/',
            },
          },
          {
            label: 'Our content sounds generic or like AI',
            result: {
              title: 'Brand voice extraction',
              why: 'It pulls a falsifiable voice profile from your best writing, then turns it into a scoring rubric for every future draft.',
              meta: '2 WORKING DAYS · BRAND STACK',
              url: '/lens/brand/brand-voice-extraction/',
            },
          },
          {
            label: 'We need a name or a tagline',
            result: {
              title: 'Naming sprint',
              why: 'It squeezes a quarter of naming committee into a working day, taking 400 candidates through phonetic and trademark filters to eight defensible finalists.',
              meta: '1 WORKING DAY · BRAND STACK',
              url: '/lens/brand/naming-sprint/',
            },
          },
        ],
      },
    },
    content: {
      label: 'Shipping more content without losing the brand',
      q2: {
        q: 'Where does content hurt most right now?',
        options: [
          {
            label: 'Drafts need a quality gate before a human sees them',
            result: {
              title: 'Eval-gated drafting',
              why: 'Drafts pass voice and fact gates before they reach an editor. Your review time goes on judgement instead of triage.',
              meta: '1 WORKING WEEK · CONTENT STACK',
              url: '/lens/content/eval-gated-drafting/',
            },
          },
          {
            label: 'Social is ad hoc and cross-posted everywhere',
            result: {
              title: 'Social content factory',
              why: 'It turns one weekly story brief into channel-native posts for each platform and checks each one against your voice profile before it ships.',
              meta: '1 WORKING WEEK · CONTENT STACK',
              url: '/lens/content/social-content-factory/',
            },
          },
          {
            label: 'Organic search is sitting there untapped',
            result: {
              title: 'SEO cluster generator',
              why: 'It builds the cluster map and the production order you need to own the searches your buyers make.',
              meta: '1 WORKING DAY · CONTENT STACK',
              url: '/lens/content/seo-cluster-generator/',
            },
          },
        ],
      },
    },
    demand: {
      label: 'Channel mix or attribution',
      q2: {
        q: 'What decision are you trying to make?',
        options: [
          {
            label: 'I need to defend a budget allocation to the CFO',
            result: {
              title: 'Channel-mix simulator',
              why: 'It fits diminishing-return curves to your last twelve months and runs twenty allocation scenarios, so you walk in with three options and the maths.',
              meta: '2 WORKING DAYS · DEMAND STACK',
              url: '/lens/demand/channel-mix-simulator/',
            },
          },
          {
            label: "Channels claim credit and nobody trusts the numbers",
            result: {
              title: 'Attribution tear-down',
              why: 'It checks GA4 against the platform pixels to find which channels are overclaiming and which are quietly working.',
              meta: '1 WORKING WEEK · DEMAND STACK',
              url: '/lens/demand/attribution-teardown/',
            },
          },
          {
            label: 'Our year revolves around races and events',
            result: {
              title: 'Race-day demand pipeline',
              why: 'You get a twelve-month campaign calendar timed to the events your audience races, with briefs and lead times worked back from each one.',
              meta: '1 WORKING WEEK · DEMAND STACK',
              url: '/lens/demand/race-day-demand-pipeline/',
            },
          },
        ],
      },
    },
    ops: {
      label: 'The system around the team is chaos',
      q2: {
        q: 'Which failure shows up first?',
        options: [
          {
            label: 'Briefs are chats, shipping is vibes',
            result: {
              title: 'Brief-to-ship pipeline',
              why: 'It gives you structured intake with a shipping cadence the whole team can see. It replaces ten tools and three standing meetings.',
              meta: '2 WORKING WEEKS · OPS STACK',
              url: '/lens/ops/brief-to-ship-pipeline/',
            },
          },
          {
            label: "There's no objective quality standard, just the editor's gut",
            result: {
              title: 'Evaluation frameworks',
              why: 'You write a rubric for each output type, deterministic where possible and LLM-as-judge where necessary, so the standard is something you can point at.',
              meta: '1 WORKING WEEK · OPS STACK',
              url: '/lens/ops/evaluation-frameworks/',
            },
          },
          {
            label: 'Brand rules live in a PDF nobody opens',
            result: {
              title: 'Brand guardrails as code',
              why: 'It turns the guidelines into a ruleset that runs against every piece before it ships, so you catch drift before you publish.',
              meta: '1 WORKING WEEK · OPS STACK',
              url: '/lens/ops/brand-guardrails-as-code/',
            },
          },
        ],
      },
    },
    productivity: {
      label: 'My own day is the problem',
      q2: {
        q: 'Where does the day leak first?',
        options: [
          {
            label: 'Mornings start reactive and stay that way',
            result: {
              title: 'Daily briefing pipeline',
              why: 'It pulls your calendar and inbox into a five-minute morning brief. The first hour of your day shrinks to five minutes.',
              meta: '1 DAY TO INSTALL, DAILY AFTER · PRODUCTIVITY STACK',
              url: '/lens/productivity/daily-briefing-pipeline/',
            },
          },
          {
            label: 'The inbox owns me',
            result: {
              title: 'Email triage and draft',
              why: 'It takes you from a hundred unread to a clean inbox in twenty minutes, with replies drafted in your voice and the real work routed into tasks.',
              meta: '1 DAY TO INSTALL, DAILY AFTER · PRODUCTIVITY STACK',
              url: '/lens/productivity/email-triage-and-draft/',
            },
          },
          {
            label: 'Meetings arrive without prep and leave without follow-up',
            result: {
              title: 'Meeting prep stack',
              why: 'You get a context pack before every meeting. Afterwards a follow-up loop updates the CRM and drafts the email, so nobody writes it up by hand.',
              meta: '1 DAY TO INSTALL, DAILY AFTER · PRODUCTIVITY STACK',
              url: '/lens/productivity/meeting-prep-stack/',
            },
          },
        ],
      },
    },
  };

  const root = document.querySelector<HTMLElement>('[data-diagnostic]');
  if (root) {
    const steps = {
      1: root.querySelector<HTMLElement>('[data-diag-step="1"]')!,
      2: root.querySelector<HTMLElement>('[data-diag-step="2"]')!,
      3: root.querySelector<HTMLElement>('[data-diag-step="3"]')!,
    };
    const opts1 = root.querySelector<HTMLElement>('[data-diag-options="1"]')!;
    const opts2 = root.querySelector<HTMLElement>('[data-diag-options="2"]')!;
    const q2El = root.querySelector<HTMLElement>('[data-diag-q2]')!;

    const show = (n: 1 | 2 | 3) => {
      steps[1].hidden = n !== 1;
      steps[2].hidden = n !== 2;
      steps[3].hidden = n !== 3;
    };

    const showResult = (r: { title: string; why: string; meta: string; url: string }) => {
      root.querySelector<HTMLElement>('[data-diag-title]')!.textContent = r.title;
      root.querySelector<HTMLElement>('[data-diag-why]')!.textContent = r.why;
      root.querySelector<HTMLElement>('[data-diag-meta]')!.textContent = r.meta;
      root.querySelector<HTMLAnchorElement>('[data-diag-link]')!.href = r.url;
      show(3);
    };

    Object.values(TREE).forEach((branch) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'diag-option';
      btn.textContent = branch.label;
      btn.addEventListener('click', () => {
        q2El.textContent = branch.q2.q;
        opts2.innerHTML = '';
        branch.q2.options.forEach((opt) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'diag-option';
          b.textContent = opt.label;
          b.addEventListener('click', () => showResult(opt.result));
          opts2.appendChild(b);
        });
        show(2);
      });
      opts1.appendChild(btn);
    });

    root.querySelector('[data-diag-back]')?.addEventListener('click', () => show(1));
    root.querySelector('[data-diag-restart]')?.addEventListener('click', () => show(1));
  }
</script>
