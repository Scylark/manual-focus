---
import Base from '../layouts/Base.astro';
import SEOHead from '../components/SEOHead.astro';
import BlogCard from '../components/BlogCard.astro';
import FocusObject from '../components/FocusObject.astro';
import HeroCyclist from '../components/HeroCyclist.astro';
import { url } from '../utils/paths';
import { readingTime, isListed } from '../utils/blog';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', isListed))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const pageTitle = 'Manual Focus, marketing agency for endurance and sports brands';
const pageDescription = 'Manual Focus is a Sheffield marketing agency for endurance and sports brands. Senior operators do the work, with AI doing the heavy lifting.';

// The hero punchline flips in a character at a time. Each word is wrapped
// so it can never break mid-word; the gap between words keeps its own
// stagger step so the rhythm matches hand-numbered chars.
const heroPunchline = 'with AI doing the heavy lifting.';
let charIndex = 0;
const heroWords = heroPunchline.split(' ').map((word) => {
  const chars = [...word].map((ch) => ({ ch, i: charIndex++ }));
  charIndex++;
  return chars;
});
---
<Base title={pageTitle} description={pageDescription} hideNavUntilScroll>
  <SEOHead slot="seo" type="website" title={pageTitle} description={pageDescription} />

  <!-- HERO — the message is on screen from the first frame; the rings and
       wordmark sequence runs as the hand-off into the rest of the page. -->
  <HeroCyclist>
    <div class="hero-inner">
      <div class="hero-eyebrow">
        <span class="dot"></span>
        <span class="mono">MANUAL FOCUS · SHEFFIELD</span>
      </div>

      <h1 class="hero-headline" data-parallax>
        <span class="hero-line hero-line-1">Senior marketing for</span>
        <span class="hero-line hero-line-1">endurance and sports brands</span>
        <span class="hero-line hero-line-2">
          <em class="hero-italic">
            {heroWords.map((chars) => (
              <><span class="word">{chars.map(({ ch, i }) => <span class="char" style={`--i: ${i}`}>{ch}</span>)}</span>{' '}</>
            ))}
          </em>
        </span>
      </h1>

      <div class="hero-meta">
        <p class="hero-sub">
          Manual Focus is a Sheffield team of senior marketing operators. We can lead
          your marketing as a fractional CMO or advise the team you have. We also build
          what you need and hand it over. There are <strong>no account managers or
          juniors</strong>, so the people on the call are the people doing the work.
        </p>
        <div class="hero-ctas">
          <a href={url('/contact/')} class="btn-cta">Book a free working session</a>
          <a href="#ways" class="btn-ghost">How we work together</a>
        </div>
      </div>

    </div>

    <div slot="hint" class="hero-scroll-hint" aria-hidden="true">
      <span class="mono">SCROLL</span>
      <span class="scroll-arrow"></span>
    </div>
  </HeroCyclist>

  <!-- PROOF — brands first, straight after the hero. Not pinned: it's a
       strip, not a statement. -->
  <section class="section section-alt logos-section">
    <div class="container">
      <div class="eyebrow">001 · IN THE WILD</div>
      <h2 class="reveal logos-headline">We've shipped work with these endurance and sports brands.</h2>
      <div class="logo-bar stagger">
        <span class="brand-mark brand-display">Classified</span>
        <span class="brand-mark brand-serif">Wahoo</span>
        <span class="brand-mark brand-display">Wattbike</span>
        <span class="brand-mark brand-mono">Ribble</span>
        <span class="brand-mark brand-display">RGT</span>
        <span class="brand-mark brand-serif">motif <em>AI</em></span>
        <span class="brand-mark brand-mono">Muuvr</span>
        <span class="brand-mark brand-display">Planet X</span>
        <span class="brand-mark brand-serif">Pelotan</span>
      </div>
      <p class="logos-note reveal">
        Outside endurance, we've run marketing in AI and fintech. We've also worked in hardware and digital assets.
      </p>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="section problem-section dwell-pin">
    <div class="dwell-pin-stage">
      <FocusObject size={320} tiltX={70} tiltY={25} spin={140} scrollSpin={90} style="top: 6%; right: 4%;" enterFrom="right" />

      <div class="container">
        <div class="eyebrow">002 · THE PROBLEM</div>
        <h2 class="big-statement reveal" data-scroll-scale style="transform-origin: left center;">
          Most campaigns stop working<br/>
          <span class="gradient-text">when launch week ends.</span>
        </h2>
        <div class="problem-grid">
          <p class="problem-copy reveal">
            Most brands still launch the way they did a decade ago. There's a six-week
            campaign with a burst of content. A paid push follows. Then everyone hopes
            something sticks. A better brief won't change that. Neither will a bigger budget.
          </p>
          <p class="problem-copy reveal">
            We build marketing that keeps working after launch week. We wire your owned
            channels into your earned and paid ones. We hand the repetitive work to AI.
            Each campaign builds on the last, so a small team ships as much as a big one.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- THREE WAYS TO WORK TOGETHER -->
  <section class="section ways-section" id="ways">
    <FocusObject size={260} tiltX={50} tiltY={15} spin={-130} scrollSpin={-110} style="top: 6%; right: 3%;" enterFrom="right" />

    <!-- Headline gets the dwell-pin treatment so the section's key
         message anchors and holds while the visitor scrolls into the
         cards. -->
    <div class="dwell-pin ways-headline-pin">
      <div class="dwell-pin-stage">
        <div class="container">
          <div class="eyebrow">003 · HOW WE WORK TOGETHER</div>
          <h2 class="big-statement reveal" data-scroll-scale style="transform-origin: left center;">
            Start with the problem<br/>
            you <span class="gradient-text">actually have</span>.
          </h2>
        </div>
      </div>
    </div>

    <!-- Three way-cards, dwell-pinned so they hold while you scroll
         through them -->
    <div class="dwell-pin ways-cards-pin">
      <div class="dwell-pin-stage">
        <FocusObject size={220} tiltX={48} tiltY={-22} spin={170} scrollSpin={-120} style="top: 8%; left: 2%;" enterFrom="left" />
        <div class="container">
          <div class="ways-grid stagger">
            <article class="way-card">
              <div class="way-num mono">/01 · STRATEGIC ADVISOR</div>
              <h3>Your team ships work without anyone steering.</h3>
              <p class="way-for">A senior marketer joins you one or two days a month, so each week's work adds up to a strategy instead of a backlog.</p>
              <ul class="way-list">
                <li>A weekly or fortnightly working session where we decide the next most important thing</li>
                <li>Reviews of work in progress before it ships</li>
                <li>Advice on which AI tools to adopt, mapped to how your team works</li>
                <li>Help with hiring and team shape from someone who has done it before</li>
              </ul>
              <p class="way-shape mono">1–2 days a month, on a day rate or monthly retainer</p>
              <a href={`${url('/contact/')}?offer=strategic-advisor`} class="btn-ghost way-cta">Book a free working session</a>
            </article>

            <article class="way-card way-card-featured">
              <div class="way-num mono"><span>/02 · FRACTIONAL CMO</span><span class="way-flag">RECOMMENDED</span></div>
              <h3>You need a part-time CMO.</h3>
              <p class="way-for">A senior marketer joins your leadership team one or two days a week. They set the thesis and run the team. Then they ship the plan, with AI doing the heavy lifting.</p>
              <ul class="way-list">
                <li>A marketing thesis and a 90-day plan in the first month</li>
                <li>We lead and grow your existing team and hold it to a standard</li>
                <li>We build AI into the workflows your team already runs, instead of adding another tool to the pile</li>
                <li>We ship the key pieces of the plan ourselves</li>
              </ul>
              <p class="way-shape mono">1–2 days a week, three-month minimum</p>
              <a href={`${url('/contact/')}?offer=fractional-cmo`} class="btn-cta way-cta">Book a free working session</a>
            </article>

            <article class="way-card">
              <div class="way-num mono">/03 · BUILD &amp; HAND OVER</div>
              <h3>You know what you need built.</h3>
              <p class="way-for">We scope it and build it in weeks, with AI wired in from the start. Then we hand it back with docs and training, so you don't depend on us afterwards.</p>
              <ul class="way-list">
                <li>Launches and brand refreshes</li>
                <li>SEO programmes and content engines</li>
                <li>Headless and rapid web builds on Shopify and BigCommerce, or WooCommerce on WordPress</li>
                <li>AI built in from day one</li>
                <li>A fixed price for a fixed scope, handed back with docs and training</li>
              </ul>
              <p class="way-shape mono">Project-based, with most builds taking 4–12 weeks</p>
              <a href={`${url('/contact/')}?offer=build-and-hand-over`} class="btn-ghost way-cta">Book a free working session</a>
            </article>
          </div>
        </div>
      </div>
    </div>

    <div class="container">
      <div class="services-cta reveal">
        <p class="services-note">If you'd rather we ran the AI workflows for you, that's <strong>Manual Focus AI</strong>. We plan and produce the content, wireframes included. It arrives in your brand on an agreed schedule, for a monthly retainer.</p>
        <a href={url('/services')} class="btn-ghost">Read the detail</a>
      </div>
    </div>
  </section>

  <!-- RESULTS — the published track record (the same figures as the About
       page). Named client case studies and a client quote slot in here
       once they're cleared to use. -->
  <section class="section section-alt results-section dwell-pin">
    <div class="dwell-pin-stage">
      <FocusObject size={280} tiltX={50} tiltY={20} spin={-160} scrollSpin={100} style="top: 6%; right: 4%;" enterFrom="right" />
      <div class="container">
        <div class="eyebrow">004 · RESULTS</div>
        <h2 class="reveal results-headline">The marketing kept <span class="gradient-text">working</span> after launch.</h2>
        <div class="ways-grid stagger">
          <article class="way-card">
            <div class="way-num mono">RGT CYCLING · GROWTH</div>
            <p class="result-stat">19k → 350k</p>
            <h3>registered users before Wahoo Fitness acquired it.</h3>
            <p class="way-for">James was on the founding team at RGT Cycling, a virtual cycling platform.</p>
          </article>
          <article class="way-card">
            <div class="way-num mono">BRAND · TURNAROUND</div>
            <p class="result-stat">−65 → +45</p>
            <h3>net promoter score.</h3>
            <p class="way-for">Customers went from mostly unwilling to recommend the brand to recommending it.</p>
          </article>
          <article class="way-card">
            <div class="way-num mono">PR · PRODUCT LAUNCH</div>
            <p class="result-stat">160+</p>
            <h3>media placements from a single launch.</h3>
            <p class="way-for">You can book a launch like this as a Build &amp; Hand Over project.</p>
          </article>
        </div>
        <p class="results-more reveal">
          The track record also includes a conversion rate lifted from 20% to 45%. Prompted
          brand recall went from 0 to 95. The work drove more than 2.2 million sessions to
          one platform. <a href={url('/about/')}>See the full track record</a>
        </p>
      </div>
    </div>
  </section>

  <!-- WHO YOU'LL WORK WITH -->
  <section class="section credibility-section dwell-pin">
    <div class="dwell-pin-stage">
      <FocusObject size={360} tiltX={58} tiltY={-12} spin={180} scrollSpin={60} style="top: 8%; right: 4%;" enterFrom="right" />

      <div class="container">
        <div class="credibility-grid">
          <div class="credibility-copy">
            <div class="eyebrow">005 · WHO YOU'LL WORK WITH</div>
            <h2 class="reveal">
              We've run marketing<br/>
              <span class="gradient-text">from the inside.</span>
            </h2>
            <p class="reveal">
              James Vickers leads Manual Focus. He has spent 15+ years running brand and
              growth in emerging tech, from fintech to sports tech. He was on the founding team
              at RGT Cycling. He works with the Foundry, a collective of senior operators
              with marketing CVs of their own. They share AI tooling so new models reach
              client work soon after they ship.
            </p>
            <a href={url('/about/')} class="btn-ghost reveal">More about James</a>
          </div>
          <picture class="credibility-photo reveal">
            <source
              type="image/webp"
              srcset={`${url('/images/james-vickers-600.webp')} 600w, ${url('/images/james-vickers-900.webp')} 900w`}
              sizes="(min-width: 900px) 440px, 100vw"
            />
            <img
              src={url('/images/james-vickers.jpg')}
              alt="James Vickers leading a line of riders up a gravel road"
              width="1200"
              height="800"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- FREE, IN THE OPEN — Light Meter (and its free indoor cycling study) and The Lens -->
  <section class="section section-alt open-section dwell-pin">
    <div class="dwell-pin-stage">
      <FocusObject size={320} tiltX={58} tiltY={18} spin={-140} scrollSpin={90} style="top: 6%; right: -4%;" enterFrom="right" />
      <div class="container">
        <div class="eyebrow">006 · FREE, IN THE OPEN</div>
        <h2 class="big-statement reveal" data-scroll-scale style="transform-origin: left center;">
          We work<br/>
          <span class="gradient-text">in the open.</span>
        </h2>
        <div class="ways-grid ways-grid-2 stagger">
          <article class="way-card">
            <div class="way-num mono"><span>/01 · LIGHT METER · AI VISIBILITY</span><span class="way-flag">NEW</span></div>
            <h3>See which brands AI recommends in your category.</h3>
            <p class="way-for">You see which brands six AI engines recommend to your buyers. You also see which sites those engines cite. Our first study, on UK indoor cycling, is free to read.</p>
            <p class="way-shape mono">6 ENGINES · 309 QUESTIONS · 5,562 ANSWERS</p>
            <a href={url('/light-meter/')} class="btn-ghost way-cta">See how Light Meter works</a>
          </article>
          <article class="way-card">
            <div class="way-num mono"><span>/02 · THE LENS · OPEN SOURCE</span><span class="way-flag way-flag-alt">FREE</span></div>
            <h3>Install our AI marketing playbooks free.</h3>
            <p class="way-for">We've published our method as 47 playbooks with 28 skills for Claude. You can read them or install them. We can also run them for you.</p>
            <p class="way-shape mono">47 PLAYBOOKS · 28 SKILLS · MIT LICENSED</p>
            <a href={url('/lens')} class="btn-ghost way-cta">Open The Lens</a>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOG / PERSPECTIVE -->
  <section class="section dwell-pin">
    <div class="dwell-pin-stage">
      <FocusObject size={320} tiltX={56} tiltY={-15} spin={140} scrollSpin={-120} style="top: 5%; left: 3%;" enterFrom="left" />
      <div class="container">
        <div class="eyebrow">007 · PERSPECTIVE</div>
        <h2 class="reveal">Read what we're learning from the work.</h2>
        <div class="blog-grid stagger">
          {posts.map(post => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              slug={post.id}
              minutes={readingTime(post.body ?? '')}
              listenMinutes={post.data.podcast && Math.round(post.data.podcast.duration / 60)}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- MANIFESTO — single sticky stage with absolutely-positioned lines that
       cross-fade as you scroll. Spacers below the stage create the scroll
       distance for the JS to drive the line index. -->
  <section class="manifesto-section" aria-label="Manifesto" data-manifesto>
    <div class="manifesto-stage">
      <p class="manifesto-line is-active" data-i="0"><span class="manifesto-text">We sharpen brands with AI.</span></p>
      <p class="manifesto-line" data-i="1"><span class="manifesto-text">Demand comes faster than the old playbook allowed.</span></p>
      <p class="manifesto-line" data-i="2"><span class="manifesto-text">Then the growth compounds.</span></p>
      <p class="manifesto-line manifesto-line-final" data-i="3"><span class="manifesto-text"><span class="gradient-text">Senior operators</span> who say what they think.</span></p>
    </div>
    <div class="manifesto-spacer"></div>
    <div class="manifesto-spacer"></div>
    <div class="manifesto-spacer"></div>
    <div class="manifesto-spacer manifesto-spacer-final"></div>
  </section>

  <!-- CTA CLOSE — with what happens after the click -->
  <section class="section cta-close dwell-pin">
    <div class="dwell-pin-stage">
      <FocusObject size={520} tiltX={60} tiltY={-20} spin={160} scrollSpin={100} style="top: -100px; left: -120px;" enterFrom="left" />
      <FocusObject size={360} tiltX={50} tiltY={25} spin={-130} scrollSpin={-90} style="bottom: -80px; right: -60px;" enterFrom="right" />

      <div class="container cta-close-inner">
        <h2 class="cta-headline reveal">
          Got a problem or a brief?<br/>
          Or a <span class="gradient-text">vague feeling</span> something's off?
        </h2>
        <p class="cta-sub reveal">Bring it and we'll work out the shape of the work together.</p>
        <ol class="cta-steps stagger">
          <li><span class="mono">01</span> We meet for a free 30-minute working session</li>
          <li><span class="mono">02</span> You get a written scope with the cost before anything starts</li>
          <li><span class="mono">03</span> Work starts, with a plan in the first month</li>
        </ol>
        <a href={url('/contact/')} class="btn-cta reveal">Book a free working session</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ============================
     HERO
     ============================ */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding-block: var(--space-xl);
  }

  .hero-inner {
    position: relative;
    z-index: 3;
    display: grid;
    gap: var(--space-sm);
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--color-text-secondary);
  }
  .hero-eyebrow .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-cta-start);
    box-shadow: 0 0 12px var(--color-cta-start);
    animation: pulse 1.6s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.3); }
  }

  .hero-headline {
    font-size: clamp(1.85rem, 4.6vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin-top: var(--space-sm);
    /* Use theme tokens — the hero used to sit over a dark dawn-sky WebGL
       cyclist which justified overriding to cream + text-shadow, but the
       new graphic hero renders on the page bg (cream in light mode, dark
       in dark mode) so theme-driven text colour is correct on both. */
    color: var(--color-text);
  }
  .hero-sub {
    color: var(--color-text-secondary);
    max-width: 540px;
  }
  .hero-eyebrow {
    color: var(--color-text-secondary);
  }
  .hero-scroll-hint .mono {
    color: var(--color-text-muted);
  }

  .hero-line {
    display: block;
    opacity: 0;
    transform: translateY(40px);
    animation: hero-line-in 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hero-line-1 { animation-delay: 0.15s; }
  /* Line 2 fades the container; chars handle their own animation */
  .hero-line-2 {
    animation-delay: 0.25s;
    perspective: 1200px;
    transform-style: preserve-3d;
  }
  .hero-line-3 { animation-delay: 0.45s; }

  @keyframes hero-line-in {
    to { opacity: 1; transform: translateY(0); }
  }

  /* Per-character flip-in for the punchline */
  .char {
    display: inline-block;
    opacity: 0;
    transform: translateY(60px) rotateX(-80deg);
    transform-origin: 50% 100% -10px;
    backface-visibility: hidden;
    animation: char-in 0.85s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(0.7s + var(--i) * 0.055s);
    /* Apply gradient directly to each char — background-clip:text on parent
       doesn't reach through inline-block children */
    font-style: italic;
    background: var(--color-cta-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    /* Extend the padding box past the italic glyph's top-right overhang so the
       gradient covers the full letter instead of clipping at the box edge.
       Negative margin-right keeps letter spacing visually identical. */
    padding-right: 0.18em;
    margin-right: -0.18em;
  }
  @keyframes char-in {
    to { opacity: 1; transform: translateY(0) rotateX(0); }
  }

  /* No gradient here: each .char carries its own. A second
     background-clip:text on this wrapper made Chrome paint a ghost
     shape over the first letter ("E" of "everyone"). */
  .hero-italic {
    font-style: italic;
  }
  /* Wrap each italic word in an inline-block so the per-char inline-blocks
     inside can never break across lines — the whole word wraps as a unit. */
  .hero-italic .word {
    display: inline-block;
    white-space: nowrap;
  }

  .hero-meta {
    margin-top: var(--space-md);
    max-width: 720px;
  }

  .hero-sub {
    font-size: var(--font-size-lg);
    color: var(--color-text);
  }
  .hero-sub strong {
    font-weight: 700;
    background: var(--color-cta-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-sm);
  }

  /* SCROLL hint sits in the bottom-right corner so it never clashes
     with the left-aligned CTAs. Earlier centred placement put it
     between the two buttons, reading as a third sibling CTA. */
  .hero-scroll-hint {
    position: absolute;
    z-index: 3;
    bottom: var(--space-md);
    right: var(--space-md);
    left: auto;
    transform: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    opacity: 0.75;
    pointer-events: none;
  }
  .scroll-arrow {
    width: 1px;
    height: 32px;
    background: linear-gradient(to bottom, var(--color-text-secondary), transparent);
    animation: scrollHint 2s ease-in-out infinite;
  }
  @keyframes scrollHint {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(8px); opacity: 1; }
  }

  /* Short-viewport guard. The hero block (5-line headline + sub +
     CTAs) lives inside a 100svh stage with overflow:hidden. The
     headline is sized off vw, so a short-but-wide window (laptop
     with docked browser, external ultrawide) blows the block past
     the stage edge and clips the CTAs. Below 860px of height the
     headline keys off vh instead, shrinking the whole block to fit. */
  @media (max-height: 860px) {
    .hero-headline {
      font-size: clamp(1.5rem, 5vh, 3.25rem);
    }
    .hero-sub {
      font-size: clamp(0.95rem, 2.3vh, 1.15rem);
    }
    .hero-meta {
      margin-top: var(--space-sm);
    }
  }
  @media (max-height: 700px) {
    .hero-headline {
      font-size: clamp(1.35rem, 4.6vh, 2.6rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line { opacity: 1; transform: none; animation: none; }
    .char { opacity: 1; transform: none; animation: none; }
    .hero-eyebrow .dot,
    .scroll-arrow { animation: none; }
  }

  /* ============================
     PROBLEM
