     Each line slides + blurs in from the right, settles, then slides out
     left as the next one takes over.
     ============================ */
  .manifesto-section {
    position: relative;
    border-top: 1px solid var(--color-line);
    background: var(--color-bg);
  }
  .manifesto-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: var(--space-md);
    overflow: hidden;
    /* Perspective on the stage gives each line real depth — they
       fly through space, not slide across a flat plane. */
    perspective: 1200px;
    perspective-origin: 50% 50%;
