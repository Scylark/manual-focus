---
import Base from '../layouts/Base.astro';
import SEOHead from '../components/SEOHead.astro';
import FocusObject from '../components/FocusObject.astro';
import { url } from '../utils/paths';
---
<Base title="About James Vickers and Manual Focus" description="James Vickers leads Manual Focus, a marketing agency for endurance and sports brands. He was on the founding team at RGT Cycling, which Wahoo bought.">
  <SEOHead slot="seo" type="profile" title="About James Vickers and Manual Focus" description="James Vickers leads Manual Focus, a marketing agency for endurance and sports brands. He was on the founding team at RGT Cycling, which Wahoo bought." breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'About', url: '/about/' }]} />

  <!-- HERO -->
  <section class="about-hero">
    <FocusObject size={300} tiltX={62} tiltY={-18} spin={120} scrollSpin={90} style="top: 4vh; right: 4vw;" />

    <div class="container about-hero-inner">
      <div class="eyebrow">001 · ABOUT</div>
      <h1 class="about-headline" style="font-size: clamp(2.5rem, 6.5vw, 6rem); line-height: 0.95; letter-spacing: -0.02em; margin-top: var(--space-md); max-width: 900px;">
        We work where<br/>
        two circles<br/>
        <span class="gradient-text">intersect.</span>
      </h1>
      <p class="about-lead">
        The Manual Focus mark is two circles drifting into alignment, and we work where
        they overlap, at the point where new technology meets the markets it changes. AI is
        changing how people find products and digital assets are changing how trust works.
        We help endurance and sports brands make the most of both changes, with the
        <strong>Foundry</strong>, our collective of senior operators, and the
        <strong>Forge</strong>, the AI toolkit the Foundry built.
      </p>
    </div>
  </section>

  <!-- WHO'S BEHIND IT -->
  <section class="about-section section-alt">
    <FocusObject size={220} tiltX={50} tiltY={20} spin={-110} scrollSpin={-80} style="bottom: -40px; left: -40px;" enterFrom="left" />

    <div class="container about-grid">
      <div class="about-grid-side">
        <div class="eyebrow">002 · THE COLLECTIVE</div>
        <h2 style="font-size: clamp(2rem, 4vw, 3.75rem); line-height: 0.98; margin-top: var(--space-xs);">Who's<br/>behind&nbsp;it.</h2>
        <picture>
          <source
            type="image/webp"
            srcset={`${url('/images/james-vickers-600.webp')} 600w, ${url('/images/james-vickers-900.webp')} 900w`}
            sizes="(min-width: 1024px) 440px, 100vw"
          />
        <img
          class="about-portrait"
          src={url('/images/james-vickers.jpg')}
          alt="James Vickers leading a line of riders up a gravel road"
          width="1200"
          height="800"
          loading="lazy"
          decoding="async"
        />
        </picture>
      </div>
      <div class="about-grid-body">
        <p>
          <strong>James Vickers</strong> leads Manual Focus and has spent 15+ years running
          sales, marketing and growth in emerging tech. He was on the founding team at RGT
          Cycling, a virtual cycling platform that grew to 350,000 users before Wahoo Fitness
          bought it. He has also led marketing for a privacy-focused crypto project worth $200M,
          and he now advises companies that use AI to manage people's wealth. He tends to get
          into these markets before the mainstream does.
        </p>
        <p class="about-links">
          <a href="https://www.linkedin.com/in/james-vickers-bke/" target="_blank" rel="noopener me">James on LinkedIn ↗</a>
        </p>
        <p>
          He works with the Foundry, a collective of operators who have led B2B and B2C
          teams from inside companies in AI, digital assets, fintech and hardware. Together
          they built the Forge, a shared AI toolkit, so new models reach client work soon
          after they ship.
        </p>
      </div>
    </div>
  </section>

  <!-- NUMBERS -->
  <section class="about-section">
    <FocusObject size={260} tiltX={60} tiltY={-15} spin={140} scrollSpin={120} style="top: -40px; right: -40px;" enterFrom="right" />

    <div class="container">
      <div class="eyebrow">003 · THE NUMBERS</div>
      <h2 class="about-h2 reveal" style="font-size: clamp(2.25rem, 5vw, 4.5rem); line-height: 0.98; max-width: 900px;">Our <span class="gradient-text">track record</span>,<br/>in numbers.</h2>
      <div class="numbers-grid stagger">
        <div class="number-card">
          <div class="number-value"><span class="num-prefix">19k →</span><span class="num-main">350k</span></div>
          <div class="number-label">registered users at RGT Cycling</div>
        </div>
        <div class="number-card">
          <div class="number-value"><span class="num-prefix">−65 →</span><span class="num-main">+45</span></div>
          <div class="number-label">net promoter score, in a brand turnaround</div>
        </div>
        <div class="number-card">
          <div class="number-value"><span class="num-main">160+</span></div>
          <div class="number-label">media placements from a single product launch</div>
        </div>
        <div class="number-card">
          <div class="number-value"><span class="num-prefix">0 →</span><span class="num-main">95</span></div>
          <div class="number-label">prompted brand recall</div>
        </div>
        <div class="number-card">
          <div class="number-value"><span class="num-prefix">20% →</span><span class="num-main">45%</span></div>
          <div class="number-label">conversion rate</div>
        </div>
        <div class="number-card">
          <div class="number-value"><span class="num-main">2.2M+</span></div>
          <div class="number-label">sessions driven to a platform</div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="about-section section-alt">
    <div class="container about-grid">
      <div class="about-grid-side">
        <div class="eyebrow">004 · WHY WE EXIST</div>
        <h2 style="font-size: clamp(2rem, 4vw, 3.75rem); line-height: 0.98; margin-top: var(--space-xs);">The <span class="gradient-text">craft</span><br/>outlasts tools<br/>that change weekly.</h2>
      </div>
      <div class="about-grid-body">
        <p>
          A new foundation model comes out every week and a new AI tool every day, so most
          teams struggle to decide what to use, and they either freeze or chase everything.
        </p>
        <p>
          The hard part is knowing which tools matter, when to use them and how to wire them
          into your owned, earned and paid channels so they produce results. We use them every
          day and test new models as they ship, so you get a senior marketer who knows the
          tools without making a full-time hire.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="about-cta">
    <div class="container about-cta-inner">
      <h2 class="about-cta-headline" style="font-size: clamp(1.75rem, 5vw, 4rem); line-height: 1; max-width: 900px;">
        Marketing that should<br/>be <span class="gradient-text">working harder</span>?
      </h2>
      <a href={url('/enquire/')} class="btn-cta" style="margin-top: var(--space-md);">Book a free working session</a>
    </div>
  </section>
</Base>

<style>
  /* ============================
     HERO
     ============================ */
  .about-hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-xl) var(--space-lg);
    min-height: 70vh;
    display: flex;
    align-items: center;
  }

  .about-hero-inner {
    position: relative;
    z-index: 3;
  }

  .about-headline {
    font-size: clamp(2.5rem, 6.5vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin-top: var(--space-md);
    max-width: 900px;
  }

  .about-lead {
    margin-top: var(--space-md);
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 680px;
    line-height: 1.55;
  }

  /* ============================
     SECTIONS
     ============================ */
  .about-section {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-xl);
  }

  .about-h2 {
    font-size: clamp(2.25rem, 5vw, 4.5rem);
    line-height: 0.98;
    max-width: 900px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    align-items: start;
    position: relative;
    z-index: 2;
  }

  .about-grid-side h2 {
    font-size: clamp(2rem, 4vw, 3.75rem);
    line-height: 0.98;
    margin-top: var(--space-xs);
  }

  .about-portrait {
    display: block;
    width: 100%;
    height: auto;
    margin-top: var(--space-md);
    border: 1px solid var(--color-line);
    border-radius: 6px;
  }

  .about-grid-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 640px;
  }

  .about-grid-body p {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .about-grid-body strong {
    color: var(--color-text);
    font-weight: 700;
  }
  .about-lead strong {
    font-weight: 700;
    background: var(--color-cta-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @media (min-width: 900px) {
    .about-grid { grid-template-columns: 1fr 1.4fr; gap: var(--space-2xl); }
  }

  /* ============================
     NUMBERS
     ============================ */
  .numbers-grid {
    margin-top: var(--space-lg);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
    position: relative;
    z-index: 2;
  }

  .number-card {
    padding: var(--space-md);
    border: 1px solid var(--color-line);
    border-radius: 4px;
    background: var(--color-card-bg);
    backdrop-filter: blur(4px);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .number-card:hover {
    border-color: var(--color-text);
    transform: translateY(-3px);
  }

  .number-value {
    font-family: var(--font-display);
    line-height: 0.95;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
  }

  .num-prefix {
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    color: var(--color-text-muted);
    letter-spacing: -0.02em;
  }

  .num-main {
    font-size: clamp(2.75rem, 4.5vw, 4rem);
    background: var(--color-cta-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.02em;
  }

  .about-links a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .number-label {
    margin-top: var(--space-sm);
    color: var(--color-text-secondary);
    font-size: var(--font-size-body);
    line-height: 1.4;
  }

  @media (min-width: 640px) {
    .numbers-grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-md); }
  }
  @media (min-width: 1024px) {
    .numbers-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* ============================
     CTA
     ============================ */
  .about-cta {
    padding-block: var(--space-2xl);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .about-cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .about-cta-headline {
    font-size: clamp(1.75rem, 5vw, 4rem);
    line-height: 1;
    max-width: 900px;
  }
</style>
