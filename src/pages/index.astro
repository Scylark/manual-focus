  }
  .manifesto-line-final .manifesto-text {
    font-family: var(--font-family);
    font-weight: 600;
    font-size: clamp(1.5rem, 4.5vw, 3.5rem);
    letter-spacing: -0.01em;
    line-height: 1.2;
    max-width: 24ch;
    text-transform: none;
